 "captions": [
  {
   "text": "If you connect 200,000",
   "emph": [
    "200000"
   ],
   "start": 0.0,
   "end": 1.71,
   "show": 0.0,
   "hide": 1.68
  },
  {
   "text": "living human brain cells",
   "emph": [
    "living"
   ],
   "start": 1.72,
   "end": 3.03,
   "show": 1.68,
   "hide": 3.0
  },
  {
   "text": "to Doom,",
   "emph": [
    "doom"
   ],
   "start": 3.04,
   "end": 3.51,
   "show": 3.0,
   "hide": 3.79
  },
  {
   "text": "they can help make the character shoot.",
   "emph": [
    "shoot"
   ],
   "start": 3.83,
   "end": 5.31,
   "show": 3.79,
   "hide": 5.63
  },
  {
   "text": "Scientists actually did it.",
   "emph": [
    "actually"
   ],
   "start": 5.67,
   "end": 7.22,
   "show": 5.63,
   "hide": 7.6
  },
  {
   "text": "The cells aren't inside someone's head.",
   "emph": [
    "head"
   ],
   "start": 7.64,
   "end": 9.31,
   "show": 7.6,
   "hide": 9.58
  },
  {
   "text": "They're growing on a chip.",
   "emph": [
    "chip"
   ],
   "start": 9.62,
   "end": 10.7,
   "show": 9.58,
   "hide": 11.12
  },
  {
   "text": "The game sends electrical signals into them,",
   "emph": [
    "electrical"
   ],
   "start": 11.16,
   "end": 13.09,
   "show": 11.12,
   "hide": 13.26
  },
  {
   "text": "and when the neurons fire back,",
   "emph": [
    "fire"
   ],
   "start": 13.3,
   "end": 14.58,
   "show": 13.26,
   "hide": 14.81
  },
  {
   "text": "software translates their activity",
   "emph": [
    "software"
   ],
   "start": 14.85,
   "end": 16.47,
   "show": 14.81,
   "hide": 16.435
  },
  {
   "text": "into commands to move, turn, and shoot.",
   "emph": [
    "move",
    "turn",
    "shoot"
   ],
   "start": 16.475,
   "end": 18.82,
   "show": 16.435,
   "hide": 19.25
  },
  {
   "text": "They're terrible at the game,",
   "emph": [
    "terrible"
   ],
   "start": 19.29,
   "end": 20.62,
   "show": 19.25,
   "hide": 20.86
  },
  {
   "text": "and a normal computer",
   "emph": [
    "computer"
   ],
   "start": 20.9,
   "end": 21.83,
   "show": 20.86,
   "hide": 21.8
  },
  {
   "text": "still does much of the work.",
   "emph": [
    "work"
   ],
   "start": 21.84,
   "end": 22.97,
   "show": 21.8,
   "hide": 23.41
  },
  {
   "text": "But the weirdest part is real.",
   "emph": [
    "weirdest"
   ],
   "start": 23.45,
   "end": 25.27,
   "show": 23.41,
   "hide": 25.83
  },
  {
   "text": "This video game controller",
   "emph": [
    "controller"
   ],
   "start": 25.87,
   "end": 27.13,
   "show": 25.83,
   "hide": 27.17
  },
  {
   "text": "is alive.",
   "emph": [
    "alive"
   ],
   "start": 27.21,
   "end": 28.03,
   "show": 27.17,
   "hide": 28.53
  }
 ],
