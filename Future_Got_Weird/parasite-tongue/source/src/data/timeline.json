 "captions": [
  {
   "text": "If this parasite gets inside a fish,",
   "start": 0.0,
   "end": 1.92
  },
  {
   "text": "it can replace its entire tongue.",
   "start": 2.2,
   "end": 3.96
  },
  {
   "text": "It crawls through the gills,",
   "start": 4.46,
   "end": 5.6
  },
  {
   "text": "latches onto the tongue,",
   "start": 5.77,
   "end": 6.88
  },
  {
   "text": "and starts stealing its blood.",
   "start": 7.03,
   "end": 8.47
  },
  {
   "text": "Eventually, the tongue withers away.",
   "start": 9.05,
   "end": 11.18
  },
  {
   "text": "But here\u2019s the disgusting part.",
   "start": 11.84,
   "end": 13.4
  },
  {
   "text": "The parasite stays attached,",
   "start": 14.02,
   "end": 15.5
  },
  {
   "text": "becoming the fish\u2019s new tongue.",
   "start": 15.77,
   "end": 17.29
  },
  {
   "text": "And the fish keeps eating,",
   "start": 17.89,
   "end": 19.09
  },
  {
   "text": "with a living parasite inside its mouth.",
   "start": 19.38,
   "end": 21.29
  }
