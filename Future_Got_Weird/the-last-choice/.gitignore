source/node_modules/
source/.remotion/
source/out/
exports/*.mp4
exports/*.wav
qa/**/f[0-9]*.png
qa/tmp/
tools/__pycache__/
audio/render/
# The supplied commercial recordings and anything containing them stay out of this PUBLIC repository.
# tools/fetch_music.sh re-downloads them from the film-audio-v1 release and extracts the audio.
audio/source/
audio/mix/
production/music/*.wav
source/public/audio/music/
source/public/audio/mix*
source/public/audio/*.wav
source/public/audio/*.mp3

# card animatic carries the music mix
qa/animatic/
qa/**/*.mp4
# prepared effects are regenerated by tools/prep_sfx.py from audio/sfx_raw
audio/sfx/*.wav

# R2 music tracks and mixes contain the supplied recordings
audio/r2/music/
audio/r2/mix/
# R2 prepared effects are regenerated by tools/r2/prep_sfx_r2.py from audio/r2/sfx_raw
audio/r2/sfx/*.wav
exports/.chunks_*/

# work-in-progress QA frames (agents write here; only final sheets are kept)
qa/r3/**/wip*/
# split parts of a master for delivery (they contain the supplied music)
exports/*/
