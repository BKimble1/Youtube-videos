 "shots": [
  {
   "id": "A1",
   "start": 0,
   "end": 3.2,
   "mv": "A",
   "note": "Puddle reflects the burning avenue; the checker’s hand slips; trapped under the overturned taxi"
  },
  {
   "id": "A2",
   "start": 3.2,
   "end": 6.4,
   "mv": "A",
   "note": "Recovery arm clamps and shifts the wreck; a drone turns its eye toward the movement"
  },
  {
   "id": "A3",
   "start": 6.4,
   "end": 10.4,
   "mv": "A",
   "note": "The Director’s hand reaches in; the pull; the taxi slams down where they were"
  },
  {
   "id": "A4",
   "start": 10.4,
   "end": 14.2,
   "mv": "A",
   "note": "Checkpoint funnel and separation; a warden gestures; the Director keeps the teammate"
  },
  {
   "id": "A5",
   "start": 14.2,
   "end": 20.5,
   "mv": "A",
   "note": "Crane up: the avenue, the elevated highway with its broken span, the refuge (on the entrance)"
  },
  {
   "id": "B1",
   "start": 20.5,
   "end": 23.779999999999998,
   "mv": "B",
   "note": "Behind a wreck: the impossible route"
  },
  {
   "id": "B2",
   "start": 23.779999999999998,
   "end": 27.4,
   "mv": "B",
   "note": "The subway grille bursts up; the builder climbs out and beckons"
  },
  {
   "id": "B3",
   "start": 27.4,
   "end": 32,
   "mv": "B",
   "note": "The visor through smoke; strap cinched (radio); nod and brim tap"
  },
  {
   "id": "B4",
   "start": 32,
   "end": 36.04,
   "mv": "B",
   "note": "In the stalled subway: a manual gate heaved up; civilians duck under and join"
  },
  {
   "id": "B5",
   "start": 36.04,
   "end": 38.699999999999996,
   "mv": "B",
   "note": "Up the exit stairs into smoky light; hands helping the last step"
  },
  {
   "id": "B6",
   "start": 38.699999999999996,
   "end": 47,
   "mv": "B",
   "note": "The assembly: battered Crew on the raised approach, machines below, the refuge beyond"
  },
  {
   "id": "C1",
   "start": 47,
   "end": 51,
   "mv": "C",
   "note": "Down the ramp toward a gap under the highway; a pole camera turns"
  },
  {
   "id": "C2",
   "start": 51,
   "end": 54.6,
   "mv": "C",
   "note": "Calm wide: vehicles ahead switch on in sequence and reposition before the Crew arrives"
  },
  {
   "id": "C3",
   "start": 54.6,
   "end": 58.6,
   "mv": "C",
   "note": "The hauler slams the gap; debris; a Crew member knocked down and hurt; helped up"
  },
  {
   "id": "C4",
   "start": 58.6,
   "end": 64.6,
   "mv": "C",
   "note": "Behind the highway pier and up a maintenance stair; drones sweep the empty gap, then tilt up"
  },
  {
   "id": "C5",
   "start": 64.6,
   "end": 69,
   "mv": "C",
   "note": "Steam under the deck: a sketch on a battered tablet becomes walking figures"
  },
  {
   "id": "C6",
   "start": 69,
   "end": 74,
   "mv": "C",
   "note": "Projected giants in the steam; the machines turn; the Crew runs for the next cover"
  },
  {
   "id": "C7",
   "start": 74,
   "end": 78.6,
   "mv": "C",
   "note": "A small drone circles the steam, sees the flat projection edge-on and follows the beam"
  },
  {
   "id": "C8",
   "start": 78.6,
   "end": 88,
   "mv": "C",
   "note": "A warden drops onto the catwalk; smashed into a column (on the splice); falls; replaced"
  },
  {
   "id": "C9",
   "start": 88,
   "end": 92,
   "mv": "C",
   "note": "Signature wide: the broken span, the gantry and basket, the landing, the refuge beyond"
  },
  {
   "id": "C10",
   "start": 92,
   "end": 95.6,
   "mv": "C",
   "note": "The operator takes the dead-man lever; a look sends the Director onto the basket"
  },
  {
   "id": "C11",
   "start": 95.6,
   "end": 101.147,
   "mv": "C",
   "note": "The transfer across the gap; landing barrier jammed; the handoff; back to the operator"
  },
  {
   "id": "C12",
   "start": 101.147,
   "end": 104.6,
   "mv": "C",
   "note": "Sensor lock; the breaker turns; a glance and a nod; the hand tightens"
  },
  {
   "id": "C13",
   "start": 104.6,
   "end": 107.6,
   "mv": "C",
   "note": "Basket docks; the operator runs onto the catwalk; the decisive blast"
  },
  {
   "id": "C14",
   "start": 107.6,
   "end": 113.6,
   "mv": "C",
   "note": "Muffled: the Director goes back along the failing catwalk; catches the hand; pulls them in"
  },
  {
   "id": "C15",
   "start": 113.6,
   "end": 118,
   "mv": "C",
   "note": "The gantry falls on the breaker; the crossing is gone"
  },
  {
   "id": "C16",
   "start": 118,
   "end": 125.747,
   "mv": "C",
   "note": "Down to the waterfront carrying the wounded friend; the refuge entrance"
  },
  {
   "id": "D1",
   "start": 125.747,
   "end": 131,
   "mv": "D",
   "note": "The doors open on warmth; attendants; the teammate on a gurney; civilians cared for"
  },
  {
   "id": "D2",
   "start": 131,
   "end": 135.5,
   "mv": "D",
   "note": "The friend on a bed; urgent care; eyes open toward the teammate they saved"
  },
  {
   "id": "D3",
   "start": 135.5,
   "end": 139,
   "mv": "D",
   "note": "Hands: the grip weakens and releases"
  },
  {
   "id": "D4",
   "start": 139,
   "end": 145,
   "mv": "D",
   "note": "The attendant stops and covers the still figure; silence; the Director keeps holding on"
  },
  {
   "id": "D5",
   "start": 145,
   "end": 153.6,
   "mv": "D",
   "note": "The radio set on the bench and switched on; the old song; the visor picked up"
  },
  {
   "id": "E1",
   "start": 153.6,
   "end": 158.4,
   "mv": "E",
   "note": "The entry doors close; the outer shutter lowers; a patrol passes"
