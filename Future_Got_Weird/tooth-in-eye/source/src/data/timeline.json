 "captions": [
  {
   "text": "Doctors put a TOOTH",
   "emph": [
    "tooth"
   ],
   "start": 0.0,
   "end": 1.24,
   "w0": 0,
   "show": 0.0,
   "hide": 1.2
  },
  {
   "text": "inside this man\u2019s EYE\u2026",
   "emph": [
    "eye"
   ],
   "start": 1.24,
   "end": 2.61,
   "w0": 4,
   "show": 1.2,
   "hide": 2.99
  },
  {
   "text": "and he could SEE AGAIN.",
   "emph": [
    "see",
    "again"
   ],
   "start": 3.03,
   "end": 4.28,
   "w0": 8,
   "show": 2.99,
   "hide": 4.75
  },
  {
   "text": "His cornea was so damaged,",
   "emph": [
    "cornea"
   ],
   "start": 4.79,
   "end": 6.43,
   "w0": 13,
   "show": 4.75,
   "hide": 6.56
  },
  {
   "text": "a normal transplant wouldn\u2019t work.",
   "emph": [],
   "start": 6.6,
   "end": 8.21,
   "w0": 18,
   "show": 6.56,
   "hide": 8.57
  },
  {
   "text": "So surgeons removed",
   "emph": [],
   "start": 8.61,
   "end": 9.56,
   "w0": 23,
   "show": 8.57,
   "hide": 9.53
  },
  {
   "text": "one of his teeth",
   "emph": [
    "teeth"
   ],
   "start": 9.57,
   "end": 10.28,
   "w0": 26,
   "show": 9.53,
   "hide": 10.25
  },
  {
   "text": "with a piece of bone,",
   "emph": [
    "bone"
   ],
   "start": 10.29,
   "end": 11.23,
   "w0": 30,
   "show": 10.25,
   "hide": 11.48
  },
  {
   "text": "drilled a hole through it,",
   "emph": [
    "hole"
   ],
   "start": 11.52,
   "end": 12.44,
   "w0": 35,
   "show": 11.48,
   "hide": 12.705
  },
  {
   "text": "and fitted a clear lens inside.",
   "emph": [
    "lens"
   ],
   "start": 12.745,
   "end": 14.4,
   "w0": 40,
   "show": 12.705,
   "hide": 14.86
  },
  {
   "text": "They tucked it beneath the skin",
   "emph": [
    "skin"
   ],
   "start": 14.9,
   "end": 16.01,
   "w0": 46,
   "show": 14.86,
   "hide": 15.97
  },
  {
   "text": "near his other eye for months,",
   "emph": [
    "months"
   ],
   "start": 16.01,
   "end": 17.47,
   "w0": 52,
   "show": 15.97,
   "hide": 17.7
  },
  {
   "text": "letting living tissue grow around it.",
   "emph": [
    "tissue"
   ],
   "start": 17.74,
   "end": 19.34,
   "w0": 58,
   "show": 17.7,
   "hide": 19.89
  },
  {
   "text": "Then they implanted it",
   "emph": [],
   "start": 19.93,
   "end": 21.21,
   "w0": 64,
   "show": 19.89,
   "hide": 21.21
  },
  {
   "text": "into his damaged eye,",
   "emph": [
    "damaged"
   ],
   "start": 21.25,
   "end": 22.4,
   "w0": 68,
   "show": 21.21,
   "hide": 22.61
  },
  {
   "text": "allowing light to reach his retina.",
   "emph": [
    "light",
    "retina"
   ],
   "start": 22.65,
   "end": 24.24,
   "w0": 72,
   "show": 22.61,
   "hide": 24.73
  },
  {
   "text": "After TEN YEARS blind\u2026",
   "emph": [
    "ten",
    "years"
   ],
   "start": 24.77,
   "end": 26.56,
   "w0": 78,
   "show": 24.73,
   "hide": 26.97
  },
  {
