 "captions": [
  {
   "text": "Doctors put a TOOTH",
   "emph": [
    "tooth"
   ],
   "start": 0.0,
   "end": 1.24,
   "w0": 0,
   "show": 0.0,
   "hide": 1.2
  },
  {
   "text": "inside this man\u2019s EYE\u2026",
   "emph": [
    "eye"
   ],
   "start": 1.24,
   "end": 2.61,
   "w0": 4,
   "show": 1.2,
   "hide": 2.83
  },
  {
   "text": "and he could SEE AGAIN.",
   "emph": [
    "see",
    "again"
   ],
   "start": 2.87,
   "end": 4.12,
   "w0": 8,
   "show": 2.83,
   "hide": 4.32
  },
  {
   "text": "His cornea was so damaged,",
   "emph": [
    "cornea"
   ],
   "start": 4.36,
   "end": 6.0,
   "w0": 13,
   "show": 4.32,
   "hide": 6.13
  },
  {
   "text": "a normal transplant wouldn\u2019t work.",
   "emph": [],
   "start": 6.17,
   "end": 7.78,
   "w0": 18,
   "show": 6.13,
   "hide": 7.98
  },
  {
   "text": "So surgeons removed",
   "emph": [],
   "start": 8.02,
   "end": 8.97,
   "w0": 23,
   "show": 7.98,
   "hide": 8.94
  },
  {
   "text": "one of his teeth",
   "emph": [
    "teeth"
   ],
   "start": 8.98,
   "end": 9.69,
   "w0": 26,
   "show": 8.94,
   "hide": 9.66
  },
  {
   "text": "with a piece of bone,",
   "emph": [
    "bone"
   ],
   "start": 9.7,
   "end": 10.64,
   "w0": 30,
   "show": 9.66,
   "hide": 10.8
  },
  {
   "text": "drilled a hole through it,",
   "emph": [
    "hole"
   ],
   "start": 10.84,
   "end": 11.76,
   "w0": 35,
   "show": 10.8,
   "hide": 11.92
  },
  {
   "text": "and fitted a clear lens inside.",
   "emph": [
    "lens"
   ],
   "start": 11.96,
   "end": 13.615,
   "w0": 40,
   "show": 11.92,
   "hide": 13.815
  },
  {
   "text": "They tucked it beneath the skin",
   "emph": [
    "skin"
   ],
   "start": 13.855,
   "end": 14.965,
   "w0": 46,
   "show": 13.815,
   "hide": 14.925
  },
  {
   "text": "near his other eye for months,",
   "emph": [
    "months"
   ],
   "start": 14.965,
   "end": 16.425,
   "w0": 52,
   "show": 14.925,
   "hide": 16.585
  },
  {
   "text": "letting living tissue grow around it.",
   "emph": [
    "tissue"
   ],
   "start": 16.625,
   "end": 18.225,
   "w0": 58,
   "show": 16.585,
   "hide": 18.445
  },
  {
   "text": "Then they implanted it",
   "emph": [],
   "start": 18.485,
   "end": 19.765,
   "w0": 64,
   "show": 18.445,
   "hide": 19.765
  },
  {
   "text": "into his damaged eye,",
   "emph": [
    "damaged"
   ],
   "start": 19.805,
   "end": 20.955,
   "w0": 68,
   "show": 19.765,
   "hide": 21.115
  },
  {
   "text": "allowing light to reach his retina.",
   "emph": [
    "light",
    "retina"
   ],
   "start": 21.155,
   "end": 22.745,
   "w0": 72,
   "show": 21.115,
   "hide": 22.965
  },
  {
   "text": "After TEN YEARS blind\u2026",
   "emph": [
    "ten",
    "years"
   ],
   "start": 23.005,
   "end": 24.795,
   "w0": 78,
   "show": 22.965,
   "hide": 25.055
  },
  {
   "text": "he could see again.",
   "emph": [
    "see",
    "again"
   ],
   "start": 25.095,
   "end": 26.115,
   "w0": 82,
   "show": 25.055,
