 ],
 "captions": [
  {
   "text": "If this sea slug",
   "emph": [],
   "start": 0.08,
   "end": 0.94,
   "show": 0.04,
   "hide": 0.94
  },
  {
   "text": "cuts off its own HEAD\u2026",
   "emph": [
    "head"
   ],
   "start": 0.98,
   "end": 1.94,
   "show": 0.94,
   "hide": 2.29
  },
  {
   "text": "that head can keep CRAWLING.",
   "emph": [
    "crawling"
   ],
   "start": 2.54,
   "end": 3.86,
   "show": 2.5,
   "hide": 4.26
  },
  {
   "text": "And its headless BODY?",
   "emph": [
    "body"
   ],
   "start": 4.3,
   "end": 5.3,
   "show": 4.26,
   "hide": 5.74
  },
  {
   "text": "It keeps MOVING too.",
   "emph": [
    "moving"
   ],
   "start": 5.78,
   "end": 6.78,
   "show": 5.74,
   "hide": 7.24
  },
  {
   "text": "You see, there\u2019s a weak spot",
   "emph": [],
   "start": 7.28,
   "end": 8.66,
   "show": 7.24,
   "hide": 8.7
  },
  {
   "text": "just behind its head.",
   "emph": [],
   "start": 8.74,
   "end": 9.58,
   "show": 8.7,
   "hide": 9.98
  },
  {
   "text": "When it breaks apart,",
   "emph": [],
   "start": 10.02,
   "end": 10.78,
   "show": 9.98,
   "hide": 11.04
  },
  {
   "text": "even its HEART stays behind.",
   "emph": [
    "heart"
   ],
   "start": 11.08,
   "end": 12.48,
   "show": 11.04,
   "hide": 12.96
  },
  {
   "text": "Scientists think it may be",
   "emph": [],
   "start": 13.0,
   "end": 14.02,
   "show": 12.96,
   "hide": 14.02
  },
  {
   "text": "escaping PARASITES",
   "emph": [
    "parasites"
   ],
   "start": 14.06,
   "end": 15.06,
   "show": 14.02,
   "hide": 15.06
  },
  {
   "text": "in its old body.",
   "emph": [],
   "start": 15.1,
   "end": 15.84,
   "show": 15.06,
   "hide": 16.28
  },
  {
   "text": "But the head",
   "emph": [],
   "start": 16.32,
   "end": 16.76,
   "show": 16.28,
   "hide": 16.82
  },
  {
   "text": "starts eating algae\u2026",
   "emph": [],
   "start": 16.86,
   "end": 17.84,
   "show": 16.82,
   "hide": 18.16
  },
  {
   "text": "and about a week later,",
   "emph": [],
   "start": 18.2,
   "end": 19.04,
   "show": 18.16,
   "hide": 19.28
  },
  {
   "text": "a NEW HEART starts BEATING.",
   "emph": [
    "new",
    "heart",
    "beating"
   ],
   "start": 19.32,
   "end": 20.74,
   "show": 19.28,
   "hide": 21.2
  },
  {
   "text": "Then, over the next few weeks,",
   "emph": [],
   "start": 21.24,
   "end": 22.6,
   "show": 21.2,
   "hide": 22.72
  },
  {
   "text": "an ENTIRE NEW BODY grows back.",
   "emph": [
    "entire",
    "new",
    "body"
   ],
   "start": 22.76,
   "end": 24.66,
   "show": 22.72,
   "hide": 25.0
  },
  {
   "text": "And one of these sea slugs",
   "emph": [],
   "start": 25.04,
   "end": 26.22,
   "show": 25.0,
   "hide": 26.28
  },
  {
   "text": "actually did it\u2026 TWICE.",
   "emph": [
    "twice"
   ],
   "start": 26.32,
   "end": 28.0,
   "show": 26.28,
   "hide": 28.667
  }
 ],
