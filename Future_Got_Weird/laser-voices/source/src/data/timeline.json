{
 "fps": 30,
 "frames": 1022,
 "duration": 34.06666666666667,
 "captions": [
  {
   "text": "If someone pointed this laser at you,",
   "emph": [],
   "start": 0.0,
   "end": 1.77,
   "show": 0,
   "hide": 1.91
  },
  {
   "text": "you could hear a voice",
   "emph": [],
   "start": 1.95,
   "end": 2.75,
   "show": 1.91,
   "hide": 2.72
  },
  {
   "text": "that nobody beside you hears.",
   "emph": [
    "nobody"
   ],
   "start": 2.76,
   "end": 4.63,
   "show": 2.72,
   "hide": 4.95
  },
  {
   "text": "And you wouldn\u2019t need",
   "emph": [],
   "start": 4.99,
   "end": 5.63,
   "show": 4.95,
   "hide": 5.63
  },
  {
   "text": "anything in your ears.",
   "emph": [],
   "start": 5.67,
   "end": 6.79,
   "show": 5.63,
   "hide": 7.16
  },
  {
   "text": "The beam is invisible.",
   "emph": [
    "invisible"
   ],
   "start": 7.2,
   "end": 8.48,
   "show": 7.16,
   "hide": 8.85
  },
  {
   "text": "But when water vapor near your ear",
   "emph": [],
   "start": 8.89,
   "end": 10.44,
   "show": 8.85,
   "hide": 10.4
  },
  {
   "text": "absorbs its light,",
   "emph": [],
   "start": 10.44,
   "end": 11.32,
   "show": 10.4,
   "hide": 11.56
  },
  {
   "text": "it heats up and expands\u2014",
   "emph": [],
   "start": 11.6,
   "end": 13.05,
   "show": 11.56,
   "hide": 13.22
  },
  {
   "text": "creating tiny sound waves.",
   "emph": [],
   "start": 13.26,
   "end": 14.71,
   "show": 13.22,
   "hide": 15.11
  },
  {
   "text": "Now, sweeping that beam",
   "emph": [],
   "start": 15.15,
   "end": 16.44,
   "show": 15.11,
   "hide": 16.4
  },
  {
   "text": "at exactly the right speed",
   "emph": [],
   "start": 16.44,
   "end": 17.82,
   "show": 16.4,
   "hide": 17.78
  },
  {
   "text": "concentrates the sound",
   "emph": [],
   "start": 17.82,
   "end": 18.98,
   "show": 17.78,
   "hide": 18.94
  },
  {
   "text": "where you\u2019re standing.",
   "emph": [],
   "start": 18.98,
   "end": 19.71,
   "show": 18.94,
   "hide": 20.06
  },
  {
   "text": "Scientists actually demonstrated this",
   "emph": [],
   "start": 20.1,
   "end": 21.79,
   "show": 20.06,
   "hide": 21.75
  },
  {
   "text": "from eight feet away.",
   "emph": [
    "eight",
    "feet"
   ],
   "start": 21.79,
   "end": 22.92,
   "show": 21.75,
   "hide": 23.33
  },
  {
   "text": "But if someone walks",
   "emph": [],
   "start": 23.37,
   "end": 24.25,
   "show": 23.33,
   "hide": 24.22
  },
  {
   "text": "between you and the laser\u2026",
   "emph": [],
   "start": 24.26,
   "end": 25.84,
   "show": 24.22,
   "hide": 26.27
  },
  {
   "text": "The voice suddenly stops.",
   "emph": [
    "stops"
   ],
   "start": 26.31,
   "end": 27.81,
   "show": 26.27,
   "hide": 28.06
  },
  {
   "text": "They can\u2019t hear your message.",
   "emph": [],
   "start": 28.1,
   "end": 29.24,
   "show": 28.06,
   "hide": 29.41
  },
  {
   "text": "They\u2019re blocking it.",
   "emph": [
    "blocking"
   ],
   "start": 29.45,
   "end": 30.3,
   "show": 29.41,
   "hide": 30.7
  },
  {
   "text": "And the second they move\u2026",
   "emph": [],
   "start": 30.74,
   "end": 31.85,
   "show": 30.7,
   "hide": 32.27
  },
  {
   "text": "You hear it again.",
   "emph": [
    "again"
   ],
   "start": 32.31,
   "end": 33.45,
   "show": 32.27,
   "hide": 34.067
  }
 ],
