 "captions": [
  {
   "text": "This robot uses other robots",
   "emph": [
    "other",
    "robots"
   ],
   "start": 0.0,
   "end": 1.77,
   "w0": 0,
   "show": 0,
   "hide": 1.73
  },
  {
   "text": "as spare body parts.",
   "emph": [
    "spare",
    "body",
    "parts"
   ],
   "start": 1.77,
   "end": 2.96,
   "w0": 5,
   "show": 1.73,
   "hide": 3.24
  },
  {
   "text": "It\u2019s built from motorized rods",
   "emph": [],
   "start": 3.28,
   "end": 4.76,
   "w0": 9,
   "show": 3.24,
   "hide": 4.73
  },
  {
   "text": "that stretch and shrink,",
   "emph": [],
   "start": 4.77,
   "end": 5.99,
   "w0": 14,
   "show": 4.73,
   "hide": 6.18
  },
  {
   "text": "with magnets at their ends.",
   "emph": [
    "magnets"
   ],
   "start": 6.22,
   "end": 7.43,
   "w0": 18,
   "show": 6.18,
   "hide": 7.84
  },
  {
   "text": "A person controls the movements,",
   "emph": [],
   "start": 7.88,
   "end": 9.38,
   "w0": 23,
   "show": 7.84,
   "hide": 9.48
  },
  {
   "text": "guiding another rod into place.",
   "emph": [],
   "start": 9.52,
   "end": 11.08,
   "w0": 28,
   "show": 9.48,
   "hide": 11.52
  },
  {
   "text": "Once it connects,",
   "emph": [],
   "start": 11.56,
   "end": 12.29,
   "w0": 33,
   "show": 11.52,
   "hide": 12.51
  },
  {
   "text": "that extra piece",
   "emph": [],
   "start": 12.55,
   "end": 13.29,
   "w0": 36,
   "show": 12.51,
   "hide": 13.25
  },
  {
   "text": "becomes a walking stick,",
   "emph": [
    "walking",
    "stick"
   ],
   "start": 13.29,
   "end": 14.41,
   "w0": 39,
   "show": 13.25,
   "hide": 14.61
  },
  {
   "text": "helping the robot",
   "emph": [],
   "start": 14.65,
   "end": 15.37,
   "w0": 43,
   "show": 14.61,
   "hide": 15.33
  },
  {
   "text": "move faster downhill.",
   "emph": [],
   "start": 15.37,
   "end": 16.55,
   "w0": 46,
   "show": 15.33,
   "hide": 17.05
  },
  {
   "text": "And if a part stops working,",
   "emph": [],
   "start": 17.09,
   "end": 18.26,
   "w0": 49,
   "show": 17.05,
   "hide": 18.48
  },
  {
   "text": "it can drop it",
   "emph": [],
   "start": 18.52,
   "end": 19.18,
   "w0": 55,
   "show": 18.48,
   "hide": 19.2
  },
  {
   "text": "and attach a replacement.",
   "emph": [
    "replacement"
   ],
   "start": 19.24,
   "end": 20.34,
   "w0": 59,
   "show": 19.2,
   "hide": 20.8
  },
  {
   "text": "So that broken robot beside it\u2026",
   "emph": [],
   "start": 20.84,
   "end": 23.02,
   "w0": 63,
   "show": 20.8,
   "hide": 23.26
  },
  {
   "text": "could become its next body part.",
   "emph": [
    "body",
    "part"
   ],
   "start": 23.3,
   "end": 24.89,
   "w0": 69,
   "show": 23.26,
   "hide": 25.24
  }
