 "captions": [
  {
   "start": 0.0,
   "end": 1.835,
   "lines": [
    "This robot",
    "has no pinky."
   ],
   "em": 4
  },
  {
   "start": 2.08,
   "end": 2.974,
   "lines": [
    "On purpose."
   ],
   "em": 1
  },
  {
   "start": 3.28,
   "end": 5.16,
   "lines": [
    "Boston Dynamics",
    "says its engineers"
   ],
   "em": null
  },
  {
   "start": 5.2,
   "end": 6.52,
   "lines": [
    "taped their",
    "ring and pinky"
   ],
   "em": 0
  },
  {
   "start": 6.56,
   "end": 8.024,
   "lines": [
    "fingers together",
    "for a day."
   ],
   "em": 4
  },
  {
   "start": 8.32,
   "end": 9.007,
   "lines": [
    "The verdict?"
   ],
   "em": 1
  },
  {
   "start": 9.28,
   "end": 10.01,
   "lines": [
    "Leave it out."
   ],
   "em": 2
  },
  {
   "start": 10.4,
   "end": 12.52,
   "lines": [
    "Atlas’s new hand",
    "has four digits,"
   ],
   "em": 4
  },
  {
   "start": 12.56,
   "end": 14.254,
   "lines": [
    "but thirteen",
    "degrees of freedom."
   ],
   "em": 1
  },
  {
   "start": 14.56,
   "end": 16.054,
   "lines": [
    "Independent",
    "ways to move."
   ],
   "em": 3
  },
  {
   "start": 16.4,
   "end": 18.08,
   "lines": [
    "The company says",
    "it can pinch,"
   ],
   "em": 5
  },
  {
   "start": 18.12,
   "end": 18.88,
   "lines": [
    "turn objects,"
   ],
   "em": 0
  },
  {
   "start": 18.92,
   "end": 20.167,
   "lines": [
    "and press",
    "tool triggers."
   ],
   "em": 1
  },
  {
   "start": 20.4,
   "end": 21.56,
   "lines": [
    "A fifth digit",
    "would mean"
   ],
   "em": 1
  },
  {
   "start": 21.6,
   "end": 22.978,
   "lines": [
    "three more",
    "actuators."
   ],
   "em": 0
  },
  {
   "start": 23.28,
   "end": 24.144,
   "lines": [
    "More cost."
   ],
   "em": 1
  },
  {
   "start": 24.24,
   "end": 24.981,
   "lines": [
    "More bulk."
   ],
   "em": 1
  },
  {
   "start": 25.2,
   "end": 26.192,
   "lines": [
    "More things",
    "to break."
   ],
   "em": 3
  },
  {
   "start": 26.64,
   "end": 28.28,
   "lines": [
    "So the goal",
    "is a useful,"
   ],
   "em": 5
  },
  {
   "start": 28.32,
   "end": 29.443,
   "lines": [
    "reliable hand."
   ],
   "em": 0
  },
  {
   "start": 29.76,
   "end": 31.156,
   "lines": [
    "Looking human",
    "is optional."
   ],
   "em": 3
  },
  {
   "start": 31.44,
   "end": 32.88,
   "lines": [
    "Apparently,",
    "even robots"
   ],
   "em": null
  },
  {
   "start": 32.92,
   "end": 33.934,
   "lines": [
    "have a budget."
   ],
   "em": 2
  }
 ],
