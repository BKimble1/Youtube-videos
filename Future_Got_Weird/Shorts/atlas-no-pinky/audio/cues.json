 "captions": [
  {
   "start": 0.0,
   "end": 1.835,
   "text": "This robot has no pinky."
  },
  {
   "start": 2.08,
   "end": 2.974,
   "text": "On purpose."
  },
  {
   "start": 3.28,
   "end": 4.44,
   "text": "Boston Dynamics says"
  },
  {
   "start": 4.48,
   "end": 6.84,
   "text": "its engineers taped their\nring and pinky fingers"
  },
  {
   "start": 6.88,
   "end": 8.024,
   "text": "together for a day."
  },
  {
   "start": 8.32,
   "end": 9.007,
   "text": "The verdict?"
  },
  {
   "start": 9.28,
   "end": 10.01,
   "text": "Leave it out."
  },
  {
   "start": 10.4,
   "end": 11.4,
   "text": "Atlas’s new hand"
  },
  {
   "start": 11.44,
   "end": 12.52,
   "text": "has four digits,"
  },
  {
   "start": 12.56,
   "end": 14.254,
   "text": "but thirteen\ndegrees of freedom."
  },
  {
   "start": 14.56,
   "end": 16.054,
   "text": "Independent ways to move."
  },
  {
   "start": 16.4,
   "end": 18.08,
   "text": "The company says it can pinch,"
  },
  {
   "start": 18.12,
   "end": 20.167,
   "text": "turn objects, and\npress tool triggers."
  },
  {
   "start": 20.4,
   "end": 21.56,
   "text": "A fifth digit would mean"
  },
  {
   "start": 21.6,
   "end": 22.978,
   "text": "three more actuators."
  },
  {
   "start": 23.28,
   "end": 24.144,
   "text": "More cost."
  },
  {
   "start": 24.24,
   "end": 24.981,
   "text": "More bulk."
  },
  {
   "start": 25.2,
   "end": 26.192,
   "text": "More things to break."
  },
  {
   "start": 26.64,
   "end": 29.443,
   "text": "So the goal is a\nuseful, reliable hand."
  },
  {
   "start": 29.76,
   "end": 31.156,
   "text": "Looking human is optional."
  },
  {
   "start": 31.44,
   "end": 33.574,
   "text": "Apparently, even\nrobots have a budget."
  }
 ],
