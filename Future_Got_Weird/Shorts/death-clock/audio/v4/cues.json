 "captions": [
  {
   "text": "This device",
   "start": 0.06,
   "end": 0.64,
   "hl": null
  },
  {
   "text": "tells you exactly",
   "start": 0.64,
   "end": 1.7,
   "hl": null
  },
  {
   "text": "when you are dying.",
   "start": 1.7,
   "end": 2.69,
   "hl": "dying."
  },
  {
   "text": "And he has",
   "start": 2.69,
   "end": 3.23,
   "hl": null
  },
  {
   "text": "just over two minutes",
   "start": 3.23,
   "end": 4.33,
   "hl": null
  },
  {
   "text": "to change it.",
   "start": 4.33,
   "end": 5.21,
   "hl": null
  },
  {
   "text": "Under the band,",
   "start": 5.21,
   "end": 6.11,
   "hl": null
  },
  {
   "text": "microscopic nano-sensors",
   "start": 6.11,
   "end": 7.57,
   "hl": "nano-sensors"
  },
  {
   "text": "slip through his skin",
   "start": 7.57,
   "end": 8.51,
   "hl": null
  },
  {
   "text": "and race into his bloodstream.",
   "start": 8.51,
   "end": 10.15,
   "hl": null
  },
  {
   "text": "They sweep past blood cells,",
   "start": 10.15,
   "end": 11.69,
   "hl": null
  },
  {
   "text": "monitoring cellular decay",
   "start": 11.69,
   "end": 13.11,
   "hl": null
  },
  {
   "text": "and sending a constant",
   "start": 13.11,
   "end": 14.23,
   "hl": null
  },
  {
   "text": "stream of signals.",
   "start": 14.23,
   "end": 15.38,
   "hl": null
  },
  {
   "text": "If an organ starts failing,",
   "start": 15.38,
   "end": 16.72,
   "hl": null
  },
  {
   "text": "or his heart slips",
   "start": 16.72,
   "end": 17.54,
   "hl": null
  },
  {
   "text": "into a lethal rhythm,",
   "start": 17.54,
   "end": 18.77,
   "hl": "lethal"
  },
  {
   "text": "the warning races",
   "start": 18.77,
   "end": 19.75,
   "hl": null
  },
  {
   "text": "back to his wrist.",
   "start": 19.75,
   "end": 20.82,
   "hl": null
  },
  {
   "text": "The red screen keeps counting.",
   "start": 20.82,
   "end": 22.51,
   "hl": null
  },
  {
   "text": "Every second matters.",
   "start": 22.51,
   "end": 24.13,
   "hl": "second"
  },
  {
   "text": "His location and medical data",
   "start": 24.13,
   "end": 25.61,
   "hl": null
  },
  {
   "text": "reach a nearby hospital,",
   "start": 25.61,
   "end": 27.05,
   "hl": null
  },
  {
   "text": "where an emergency drone",
   "start": 27.05,
   "end": 28.13,
   "hl": null
  },
  {
   "text": "launches straight toward him.",
   "start": 28.13,
   "end": 29.63,
   "hl": null
  },
  {
   "text": "While help is coming,",
   "start": 29.63,
   "end": 30.71,
   "hl": null
  },
  {
   "text": "the band delivers",
   "start": 30.71,
   "end": 31.43,
   "hl": null
  },
  {
   "text": "an automatic injection,",
   "start": 31.43,
   "end": 32.85,
   "hl": null
  },
  {
   "text": "potentially buying him time.",
   "start": 32.85,
   "end": 34.5,
   "hl": null
  },
  {
   "text": "His heartbeat steadies",
   "start": 34.5,
   "end": 35.52,
   "hl": null
  },
  {
   "text": "as he sits up.",
   "start": 35.52,
   "end": 36.53,
   "hl": null
  },
  {
   "text": "Green replaces red:",
   "start": 36.53,
   "end": 37.94,
   "hl": null
  },
  {
   "text": "life expectancy,",
   "start": 37.94,
   "end": 39.1,
   "hl": null
  },
  {
   "text": "forty-two years.",
   "start": 39.1,
   "end": 40.3,
   "hl": "forty-two"
  },
  {
   "text": "But that number",
   "start": 40.3,
   "end": 40.94,
   "hl": null
  },
  {
   "text": "already changed once.",
   "start": 40.94,
   "end": 42.38,
   "hl": null
  },
  {
   "text": "If your countdown started,",
   "start": 42.38,
   "end": 43.76,
   "hl": null
  },
  {
   "text": "would you want to know?",
   "start": 43.76,
   "end": 44.78,
   "hl": "know?"
  }
 ],
 "words": 136
}