 "captions": [
  {
   "text": "This device",
   "start": 0.06,
   "end": 0.66,
   "hl": null
  },
  {
   "text": "tells you exactly",
   "start": 0.66,
   "end": 1.8,
   "hl": null
  },
  {
   "text": "when you are dying.",
   "start": 1.8,
   "end": 3.28,
   "hl": "dying."
  },
  {
   "text": "It works by injecting",
   "start": 4.22,
   "end": 5.4,
   "hl": null
  },
  {
   "text": "thousands of",
   "start": 5.4,
   "end": 6.06,
   "hl": null
  },
  {
   "text": "microscopic nano-sensors",
   "start": 6.06,
   "end": 7.58,
   "hl": "nano-sensors"
  },
  {
   "text": "through your skin.",
   "start": 7.58,
   "end": 9,
   "hl": null
  },
  {
   "text": "These sensors constantly travel",
   "start": 9.42,
   "end": 11.1,
   "hl": null
  },
  {
   "text": "through your bloodstream,",
   "start": 11.1,
   "end": 12.2,
   "hl": null
  },
  {
   "text": "monitoring your",
   "start": 12.2,
   "end": 12.9,
   "hl": null
  },
  {
   "text": "cellular decay.",
   "start": 12.9,
   "end": 14.46,
   "hl": null
  },
  {
   "text": "If your organs",
   "start": 15.52,
   "end": 16.16,
   "hl": null
  },
  {
   "text": "begin to fail,",
   "start": 16.16,
   "end": 17.3,
   "hl": null
  },
  {
   "text": "or your heart",
   "start": 17.3,
   "end": 17.8,
   "hl": null
  },
  {
   "text": "experiences a lethal rhythm,",
   "start": 17.8,
   "end": 20.059,
   "hl": "lethal"
  },
  {
   "text": "the device immediately",
   "start": 20.07,
   "end": 21.23,
   "hl": null
  },
  {
   "text": "calculates your",
   "start": 21.23,
   "end": 21.89,
   "hl": null
  },
  {
   "text": "remaining life expectancy",
   "start": 21.89,
