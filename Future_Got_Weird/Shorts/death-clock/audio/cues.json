 "captions": [
  {
   "text": "This device",
   "start": 0.06,
   "end": 0.66,
   "hl": null,
   "caps": false
  },
  {
   "text": "tells you exactly",
   "start": 0.66,
   "end": 1.7,
   "hl": "exactly",
   "caps": false
  },
  {
   "text": "when you are dying.",
   "start": 1.7,
   "end": 3.26,
   "hl": "dying.",
   "caps": false
  },
  {
   "text": "It works by injecting",
   "start": 3.76,
   "end": 4.88,
   "hl": "injecting",
   "caps": false
  },
  {
   "text": "thousands of",
   "start": 4.88,
   "end": 5.48,
   "hl": null,
   "caps": false
  },
  {
   "text": "microscopic nano-sensors",
   "start": 5.48,
   "end": 6.9,
   "hl": "nano-sensors",
   "caps": true
  },
  {
   "text": "through your skin.",
   "start": 6.9,
   "end": 8.36,
   "hl": "skin.",
   "caps": false
  },
  {
   "text": "These sensors constantly travel",
   "start": 8.42,
   "end": 9.98,
   "hl": "travel",
   "caps": false
  },
  {
   "text": "through your bloodstream,",
   "start": 9.98,
   "end": 11.04,
   "hl": "bloodstream,",
   "caps": false
  },
  {
   "text": "monitoring your",
   "start": 11.04,
   "end": 11.7,
   "hl": null,
   "caps": false
  },
  {
   "text": "cellular decay.",
   "start": 11.7,
   "end": 13.24,
   "hl": "decay.",
   "caps": false
  },
  {
   "text": "If your organs",
   "start": 13.77,
   "end": 14.37,
   "hl": "organs",
   "caps": false
  },
  {
   "text": "begin to fail,",
   "start": 14.37,
   "end": 15.25,
   "hl": "fail,",
   "caps": false
  },
  {
   "text": "or your heart",
   "start": 15.25,
   "end": 15.81,
   "hl": "heart",
   "caps": false
  },
  {
   "text": "experiences a lethal rhythm,",
   "start": 15.81,
   "end": 17.99,
   "hl": "lethal",
   "caps": false
  },
  {
   "text": "the device immediately",
   "start": 18.089,
   "end": 19.23,
   "hl": "immediately",
   "caps": false
  },
  {
   "text": "calculates your",
   "start": 19.23,
   "end": 19.83,
   "hl": null,
   "caps": false
  },
  {
   "text": "remaining life expectancy",
   "start": 19.83,
   "end": 21.15,
   "hl": "expectancy",
   "caps": false
  },
  {
   "text": "down to the exact second.",
   "start": 21.15,
   "end": 23.39,
   "hl": "second.",
   "caps": true
  },
  {
   "text": "This gives you",
   "start": 24.88,
   "end": 25.36,
   "hl": null,
   "caps": false
  },
  {
   "text": "a critical window",
   "start": 25.36,
   "end": 26.2,
   "hl": "critical",
   "caps": false
  },
  {
   "text": "to seek help.",
   "start": 26.2,
   "end": 27.54,
   "hl": "help.",
   "caps": false
  },
  {
   "text": "The device automatically",
   "start": 28.02,
   "end": 29.14,
   "hl": "automatically",
   "caps": false
  },
  {
   "text": "alerts emergency services",
   "start": 29.14,
   "end": 30.5,
   "hl": "emergency",
   "caps": false
  },
  {
   "text": "with your exact location",
   "start": 30.5,
   "end": 31.76,
   "hl": "location",
   "caps": false
  },
  {
   "text": "and medical data,",
   "start": 31.76,
   "end": 33.24,
   "hl": "data,",
   "caps": false
  },
  {
   "text": "potentially saving your life",
   "start": 33.62,
   "end": 34.96,
   "hl": "potentially",
   "caps": false
  },
  {
   "text": "before you even",
   "start": 34.96,
   "end": 35.8,
   "hl": null,
   "caps": false
  },
  {
   "text": "lose consciousness.",
   "start": 35.8,
   "end": 37.44,
   "hl": "consciousness.",
   "caps": false
  },
  {
   "text": "But if the countdown starts,",
   "start": 40.019,
   "end": 42.04,
   "hl": "countdown",
   "caps": false
  },
  {
   "text": "would you want to know?",
   "start": 42.09,
   "end": 43.57,
   "hl": "know?",
   "caps": false
  }
 ],
