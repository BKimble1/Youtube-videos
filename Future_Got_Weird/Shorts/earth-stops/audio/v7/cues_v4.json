  {
   "a": 0,
   "b": 34,
   "dy": 0,
   "text": "If Earth stopped,"
  },
  {
   "a": 35,
   "b": 73,
   "dy": 0,
   "text": "you’d keep moving east—"
  },
  {
   "a": 74,
   "b": 95,
   "dy": 0,
   "text": "about a thousand"
  },
  {
   "a": 96,
   "b": 115,
   "dy": 0,
   "text": "miles an hour"
  },
  {
   "a": 116,
   "b": 140,
   "dy": 0,
   "text": "at the equator."
  },
  {
   "a": 143,
   "b": 191,
   "dy": 0,
   "text": "Loose objects keep going too."
  },
  {
   "a": 196,
   "b": 224,
   "dy": 0,
   "text": "So does the air,"
  },
  {
   "a": 225,
   "b": 275,
   "dy": 0,
   "text": "driving debris through the streets."
  },
  {
   "a": 281,
   "b": 320,
   "dy": 880,
   "text": "And the ocean keeps moving"
  },
  {
   "a": 321,
   "b": 350,
   "dy": 880,
   "text": "into the coast."
  },
  {
   "a": 353,
   "b": 389,
   "dy": -60,
   "text": "You don’t feel the spin"
  },
  {
   "a": 390,
   "b": 428,
   "dy": -60,
   "text": "because you move with Earth."
  },
  {
   "a": 430,
   "b": 463,
   "dy": 0,
   "text": "Closer to the poles,"
  },
  {
   "a": 465,
   "b": 512,
   "dy": 0,
   "text": "that starting speed is lower."
  },
