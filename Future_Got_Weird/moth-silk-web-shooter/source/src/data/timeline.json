 "captions": [
  {
   "text": "Imagine firing liquid",
   "emph": [],
   "start": 0.1,
   "end": 1.52,
   "show": 0.06,
   "hide": 1.48
  },
  {
   "text": "at a criminal\u2014",
   "emph": [
    "criminal"
   ],
   "start": 1.52,
   "end": 2.07,
   "show": 1.48,
   "hide": 2.46
  },
  {
   "text": "and watching it turn into a web",
   "emph": [
    "web"
   ],
   "start": 2.5,
   "end": 4.0,
   "show": 2.46,
   "hide": 3.97
  },
  {
   "text": "that catches them.",
   "emph": [
    "catches"
   ],
   "start": 4.01,
   "end": 4.85,
   "show": 3.97,
   "hide": 5.29
  },
  {
   "text": "Scientists have taken",
   "emph": [],
   "start": 5.33,
   "end": 6.31,
   "show": 5.29,
   "hide": 6.27
  },
  {
   "text": "the first step toward that.",
   "emph": [
    "first",
    "step"
   ],
   "start": 6.31,
   "end": 7.42,
   "show": 6.27,
   "hide": 7.82
  },
  {
   "text": "They start with silk",
   "emph": [
    "silk"
   ],
   "start": 7.86,
   "end": 8.72,
   "show": 7.82,
   "hide": 8.69
  },
  {
   "text": "from moth cocoons",
   "emph": [
    "moth",
    "cocoons"
   ],
   "start": 8.73,
   "end": 9.71,
   "show": 8.69,
   "hide": 9.69
  },
  {
   "text": "and dissolve it into a liquid.",
   "emph": [
    "liquid"
   ],
   "start": 9.73,
   "end": 11.06,
   "show": 9.69,
   "hide": 11.43
  },
  {
   "text": "As it shoots",
   "emph": [],
   "start": 11.47,
   "end": 12.03,
   "show": 11.43,
   "hide": 12.0
  },
  {
   "text": "through a special nozzle,",
   "emph": [
    "nozzle"
   ],
   "start": 12.04,
   "end": 13.17,
   "show": 12.0,
   "hide": 13.32
  },
  {
   "text": "a surrounding layer of acetone",
   "emph": [
    "acetone"
   ],
   "start": 13.36,
   "end": 14.9,
   "show": 13.32,
   "hide": 14.86
  },
  {
   "text": "triggers the silk to harden.",
   "emph": [
    "harden"
   ],
   "start": 14.9,
   "end": 16.27,
   "show": 14.86,
   "hide": 16.59
  },
  {
   "text": "A sticky fiber",
   "emph": [
    "sticky"
   ],
   "start": 16.63,
   "end": 17.5,
   "show": 16.59,
   "hide": 17.46
  },
  {
   "text": "forms in midair.",
   "emph": [
    "midair"
   ],
   "start": 17.5,
   "end": 18.35,
   "show": 17.46,
   "hide": 18.7
  },
  {
   "text": "It hits the metal",
   "emph": [
    "metal"
   ],
   "start": 18.74,
   "end": 19.5,
   "show": 18.7,
   "hide": 19.46
  },
  {
   "text": "and attaches.",
   "emph": [
    "attaches"
   ],
   "start": 19.5,
   "end": 20.25,
   "show": 19.46,
   "hide": 20.6
  },
  {
   "text": "Then you pull\u2014",
   "emph": [
    "pull"
   ],
   "start": 20.64,
   "end": 21.37,
   "show": 20.6,
   "hide": 21.64
  },
  {
   "text": "and the blade lifts",
   "emph": [
    "lifts"
   ],
   "start": 21.68,
   "end": 22.63,
   "show": 21.64,
   "hide": 22.59
  },
  {
   "text": "out of the sand.",
   "emph": [
    "sand"
   ],
   "start": 22.63,
   "end": 23.33,
   "show": 22.59,
   "hide": 23.72
  },
  {
   "text": "In lab tests,",
   "emph": [],
   "start": 23.76,
   "end": 24.57,
   "show": 23.72,
   "hide": 24.66
  },
  {
   "text": "these fibers lifted over",
   "emph": [],
   "start": 24.7,
   "end": 25.89,
   "show": 24.66,
   "hide": 25.86
  },
  {
   "text": "eighty times their own weight.",
   "emph": [
    "eighty",
    "times"
   ],
   "start": 25.9,
   "end": 27.49,
   "show": 25.86,
   "hide": 27.87
  },
  {
   "text": "The beginnings",
   "emph": [],
   "start": 27.91,
   "end": 28.5,
   "show": 27.87,
   "hide": 28.46
  },
  {
   "text": "of a real web shooter\u2026",
   "emph": [
    "web",
    "shooter"
   ],
   "start": 28.5,
   "end": 29.69,
   "show": 28.46,
   "hide": 30.06
  },
  {
   "text": "made from moth silk.",
   "emph": [
    "moth",
    "silk"
   ],
   "start": 30.1,
   "end": 31.12,
   "show": 30.06,
   "hide": 31.47
  }
 ],
