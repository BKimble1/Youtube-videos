 "captions": [
  {
   "text": "If you hid",
   "emph": [],
   "start": 0.0,
   "end": 0.48,
   "show": 0,
   "hide": 0.43
  },
  {
   "text": "behind this wall\u2026",
   "emph": [],
   "start": 0.48,
   "end": 1.31,
   "show": 0.43,
   "hide": 1.565
  },
  {
   "text": "this machine could",
   "emph": [],
   "start": 1.615,
   "end": 2.265,
   "show": 1.565,
   "hide": 2.225
  },
  {
   "text": "STILL WATCH YOU.",
   "emph": [
    "still",
    "watch",
    "you"
   ],
   "start": 2.275,
   "end": 3.315,
   "show": 2.225,
   "hide": 3.59
  },
  {
   "text": "Scientists built a system",
   "emph": [],
   "start": 3.64,
   "end": 4.86,
   "show": 3.59,
   "hide": 4.81
  },
  {
   "text": "that shoots invisible",
   "emph": [],
   "start": 4.86,
   "end": 5.75,
   "show": 4.81,
   "hide": 5.7
  },
  {
   "text": "radio waves",
   "emph": [],
   "start": 5.75,
   "end": 6.39,
   "show": 5.7,
   "hide": 6.35
  },
  {
   "text": "THROUGH walls.",
   "emph": [
    "through",
    "walls"
   ],
   "start": 6.4,
   "end": 7.1,
   "show": 6.35,
   "hide": 7.315
  },
  {
   "text": "And when they bounce",
   "emph": [],
   "start": 7.365,
   "end": 7.985,
   "show": 7.315,
   "hide": 7.935
  },
  {
   "text": "off your body,",
   "emph": [],
   "start": 7.985,
   "end": 8.665,
   "show": 7.935,
   "hide": 8.875
  },
  {
   "text": "AI creates",
   "emph": [],
   "start": 8.925,
   "end": 9.595,
   "show": 8.875,
   "hide": 9.555
  },
  {
   "text": "a moving SKELETON of you.",
   "emph": [
    "skeleton"
   ],
   "start": 9.605,
   "end": 10.995,
   "show": 9.555,
   "hide": 11.245
  },
  {
   "text": "Raise your hand?",
   "emph": [],
   "start": 11.295,
   "end": 11.855,
   "show": 11.245,
   "hide": 12.09
  },
  {
   "text": "It raises its hand.",
   "emph": [],
   "start": 12.14,
   "end": 13.1,
   "show": 12.09,
   "hide": 13.365
  },
  {
   "text": "But here's where",
   "emph": [],
   "start": 13.415,
   "end": 14.055,
   "show": 13.365,
   "hide": 14.005
  },
  {
   "text": "it gets CREEPY.",
   "emph": [
    "creepy"
   ],
   "start": 14.055,
   "end": 14.905,
   "show": 14.005,
   "hide": 15.265
  },
  {
   "text": "In a separate experiment,",
   "emph": [],
   "start": 15.315,
   "end": 16.325,
   "show": 15.265,
   "hide": 16.515
  },
  {
   "text": "scientists used",
   "emph": [],
   "start": 16.565,
   "end": 17.355,
   "show": 16.515,
   "hide": 17.305
  },
  {
   "text": "ordinary Wi-Fi signals",
   "emph": [
    "wifi"
   ],
   "start": 17.355,
   "end": 18.775,
   "show": 17.305,
   "hide": 18.725
  },
  {
   "text": "to IDENTIFY",
   "emph": [
    "identify"
   ],
   "start": 18.775,
   "end": 19.405,
   "show": 18.725,
   "hide": 19.365
  },
  {
   "text": "people walking past.",
   "emph": [],
   "start": 19.415,
   "end": 20.545,
   "show": 19.365,
   "hide": 20.75
  },
  {
   "text": "Even WITHOUT",
   "emph": [
    "without"
   ],
   "start": 20.8,
   "end": 21.36,
   "show": 20.75,
   "hide": 21.33
  },
  {
   "text": "their phones.",
   "emph": [
    "their",
    "phones"
   ],
   "start": 21.38,
   "end": 22.12,
   "show": 21.33,
   "hide": 22.375
  },
  {
   "text": "They tested",
   "emph": [],
   "start": 22.425,
   "end": 22.865,
   "show": 22.375,
   "hide": 22.815
  },
  {
   "text": "197 people\u2026",
   "emph": [
    "197",
    "people"
   ],
   "start": 22.865,
   "end": 24.445,
   "show": 22.815,
   "hide": 24.665
  },
  {
   "text": "and identified",
   "emph": [],
   "start": 24.715,
   "end": 25.355,
   "show": 24.665,
   "hide": 25.305
  },
  {
   "text": "almost EVERYONE correctly.",
   "emph": [
    "everyone"
   ],
   "start": 25.355,
   "end": 26.795,
   "show": 25.305,
   "hide": 27.09
  },
  {
   "text": "So imagine",
   "emph": [],
   "start": 27.14,
   "end": 27.73,
   "show": 27.09,
   "hide": 27.68
  },
  {
   "text": "walking past a caf\u00e9,",
   "emph": [],
   "start": 27.73,
   "end": 29.0,
   "show": 27.68,
   "hide": 29.205
  },
  {
   "text": "and it recognizes you",
   "emph": [],
   "start": 29.255,
   "end": 30.235,
   "show": 29.205,
   "hide": 30.185
  },
  {
   "text": "without you doing ANYTHING.",
   "emph": [
    "anything"
   ],
   "start": 30.235,
   "end": 32.05,
   "show": 30.185,
   "hide": 32.0
  },
  {
   "text": "Now would you rather",
   "emph": [],
   "start": 32.05,
   "end": 32.82,
   "show": 32.0,
   "hide": 32.77
  },
  {
   "text": "have a CAMERA",
   "emph": [
    "camera"
   ],
   "start": 32.82,
   "end": 33.45,
   "show": 32.77,
   "hide": 33.4
  },
  {
   "text": "watching you\u2026",
   "emph": [],
   "start": 33.45,
   "end": 34.03,
   "show": 33.4,
   "hide": 34.41
  },
  {
   "text": "Or Wi-Fi",
   "emph": [
    "wifi"
   ],
   "start": 34.46,
   "end": 35.05,
   "show": 34.41,
   "hide": 35.01
  },
  {
   "text": "that knows who you are?",
   "emph": [],
   "start": 35.06,
   "end": 35.92,
   "show": 35.01,
   "hide": 36.417
  }
 ],
