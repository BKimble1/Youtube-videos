 "captions": [
  {
   "text": "This button doesn't exist.",
   "emph": [
    "doesn't",
    "exist"
   ],
   "start": 0.0,
   "end": 1.64,
   "show": 0.0,
   "hide": 1.89
  },
  {
   "text": "But you can FEEL it.",
   "emph": [
    "feel"
   ],
   "start": 1.93,
   "end": 2.82,
   "show": 1.89,
   "hide": 3.06
  },
  {
   "text": "Look. Nothing is touching his finger.",
   "emph": [],
   "start": 3.1,
   "end": 5.0,
   "show": 3.06,
   "hide": 5.25
  },
  {
   "text": "So why can he feel a button?",
   "emph": [],
   "start": 5.29,
   "end": 6.67,
   "show": 5.25,
   "hide": 6.92
  },
  {
   "text": "Under his hand,",
   "emph": [],
   "start": 6.96,
   "end": 7.77,
   "show": 6.92,
   "hide": 7.735
  },
  {
   "text": "hundreds of tiny speakers",
   "emph": [],
   "start": 7.775,
   "end": 9.17,
   "show": 7.735,
   "hide": 9.135
  },
  {
   "text": "fire ultrasound waves.",
   "emph": [
    "ultrasound"
   ],
   "start": 9.175,
   "end": 10.45,
   "show": 9.135,
   "hide": 10.7
  },
  {
   "text": "They meet at one exact spot,",
   "emph": [],
   "start": 10.74,
   "end": 12.15,
   "show": 10.7,
   "hide": 12.32
  },
  {
   "text": "making his skin feel pressure.",
   "emph": [],
   "start": 12.36,
   "end": 13.8,
   "show": 12.32,
   "hide": 14.04
  },
  {
   "text": "Move that spot,",
   "emph": [],
   "start": 14.08,
   "end": 14.8,
   "show": 14.04,
   "hide": 14.94
  },
  {
   "text": "and you can make an invisible button",
   "emph": [],
   "start": 14.98,
   "end": 16.32,
   "show": 14.94,
   "hide": 16.29
  },
  {
   "text": "feel like it's moving.",
   "emph": [],
   "start": 16.33,
   "end": 17.32,
   "show": 16.29,
   "hide": 17.57
  },
  {
   "text": "No glove.",
   "emph": [],
   "start": 17.61,
   "end": 18.2,
   "show": 17.57,
   "hide": 18.42
  },
  {
   "text": "No physical button.",
   "emph": [
    "no",
    "button"
   ],
   "start": 18.46,
   "end": 19.37,
   "show": 18.42,
   "hide": 19.61
  },
  {
   "text": "Now imagine reaching into thin air",
   "emph": [],
   "start": 19.65,
   "end": 21.36,
   "show": 19.61,
   "hide": 21.325
  },
  {
   "text": "and feeling the controls of your car.",
   "emph": [],
   "start": 21.365,
   "end": 23.08,
   "show": 21.325,
   "hide": 23.33
  },
  {
   "text": "Or pressing a floating button",
   "emph": [],
   "start": 23.37,
   "end": 24.66,
   "show": 23.33,
   "hide": 24.625
  },
  {
   "text": "without touching a screen.",
   "emph": [],
   "start": 24.665,
   "end": 25.79,
   "show": 24.625,
   "hide": 26.04
  },
  {
   "text": "And here's the weird part.",
   "emph": [],
   "start": 26.08,
   "end": 27.19,
   "show": 26.04,
   "hide": 27.5
  },
  {
   "text": "You can't actually grab it.",
   "emph": [],
   "start": 27.54,
   "end": 28.93,
   "show": 27.5,
   "hide": 29.17
  },
  {
   "text": "But your skin can still feel it.",
   "emph": [
    "feel"
   ],
   "start": 29.21,
   "end": 30.64,
   "show": 29.17,
   "hide": 31.133
  }
 ],
