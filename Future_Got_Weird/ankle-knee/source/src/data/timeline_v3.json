 "captions": [
  {
   "text": "Doctors turned this boy\u2019s ankle",
   "emph": [
    "ankle"
   ],
   "start": 0.0,
   "end": 1.59,
   "show": 0.0,
   "hide": 1.56
  },
  {
   "text": "into a working knee.",
   "emph": [
    "working",
    "knee"
   ],
   "start": 1.6,
   "end": 2.84,
   "show": 1.56,
   "hide": 3.09
  },
  {
   "text": "Wyatt had bone cancer.",
   "emph": [
    "bone",
    "cancer"
   ],
   "start": 3.13,
   "end": 4.42,
   "show": 3.09,
   "hide": 4.69
  },
  {
   "text": "Surgeons had to remove his knee,",
   "emph": [
    "remove"
   ],
   "start": 4.73,
   "end": 6.31,
   "show": 4.69,
   "hide": 6.45
  },
  {
   "text": "but they could save his foot.",
   "emph": [
    "save",
    "foot"
   ],
   "start": 6.49,
   "end": 7.64,
   "show": 6.45,
   "hide": 7.89
  },
  {
   "text": "They turned his lower leg halfway around",
   "emph": [
    "halfway",
    "around"
   ],
   "start": 7.93,
   "end": 9.78,
   "show": 7.89,
   "hide": 9.745
  },
  {
   "text": "and attached it to his thigh,",
   "emph": [
    "thigh"
   ],
   "start": 9.785,
   "end": 11.22,
   "show": 9.745,
   "hide": 11.39
  },
  {
   "text": "with his toes pointing behind him.",
   "emph": [
    "pointing",
    "behind"
   ],
   "start": 11.43,
   "end": 13.15,
   "show": 11.39,
   "hide": 13.4
  },
  {
   "text": "That backward ankle now bent",
   "emph": [
    "backward",
    "ankle"
   ],
   "start": 13.44,
   "end": 14.83,
   "show": 13.4,
   "hide": 14.855
  },
  {
   "text": "the same way as his other knee.",
   "emph": [
    "same",
    "way"
   ],
   "start": 14.895,
   "end": 16.36,
   "show": 14.855,
   "hide": 16.6
  },
  {
   "text": "When Wyatt woke up,",
   "emph": [
    "woke"
   ],
   "start": 16.64,
   "end": 17.49,
   "show": 16.6,
   "hide": 17.7
  },
  {
   "text": "he could still wiggle his toes.",
   "emph": [
    "wiggle",
    "toes"
   ],
   "start": 17.74,
   "end": 19.25,
   "show": 17.7,
   "hide": 19.5
  },
  {
   "text": "And once he learned",
   "emph": [
    "learned"
   ],
   "start": 19.54,
   "end": 20.11,
   "show": 19.5,
   "hide": 20.075
  },
  {
   "text": "to use his new leg,",
   "emph": [
    "new",
    "leg"
   ],
   "start": 20.115,
   "end": 21.1,
   "show": 20.075,
   "hide": 21.31
  },
  {
   "text": "that same foot helped him",
   "emph": [
    "same",
    "foot"
   ],
   "start": 21.35,
   "end": 22.54,
   "show": 21.31,
   "hide": 22.57
  },
  {
   "text": "kick a soccer ball.",
   "emph": [
    "soccer",
    "ball"
   ],
   "start": 22.61,
   "end": 23.55,
   "show": 22.57,
   "hide": 24.167
  }
 ],
