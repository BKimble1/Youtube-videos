    "heating"
   ],
   "start": 13.37,
   "end": 14.68,
   "show": 13.33,
   "hide": 14.64
  },
  {
   "text": "through the sky.",
   "emph": [],
   "start": 14.68,
   "end": 15.87,
   "show": 14.64,
   "hide": 15.83
  },
  {
   "text": "That gave electricity",
   "emph": [],
   "start": 15.87,
   "end": 16.96,
   "show": 15.83,
   "hide": 16.92
  },
  {
   "text": "an easier path to travel.",
   "emph": [
    "easier",
    "path"
   ],
   "start": 16.96,
   "end": 18.37,
   "show": 16.92,
   "hide": 18.79
  },
  {
