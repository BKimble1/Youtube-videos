 "captions": [
  {
   "text": "They fired a laser",
   "emph": [
    "laser"
   ],
   "start": 0.0,
   "end": 1.2,
   "show": 0,
   "hide": 1.16
  },
  {
   "text": "into a thunderstorm\u2014",
   "emph": [
    "thunderstorm"
   ],
   "start": 1.2,
   "end": 2.27,
   "show": 1.16,
   "hide": 2.52
  },
  {
   "text": "and the lightning followed it.",
