 "captions": [
  {
   "text": "If this parasite gets inside a snail,",
   "emph": [
    "snail"
   ],
   "start": 0.0,
   "end": 2.1,
   "show": 0.0,
   "hide": 2.27
  },
  {
   "text": "it can turn its eyes",
