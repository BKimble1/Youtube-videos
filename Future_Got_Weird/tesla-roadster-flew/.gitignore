# Dependencies and Remotion caches
source/node_modules/
source/.remotion/
# Renders: review copies and masters are regenerated with tools/render_short.sh
exports/
# Official Tesla clips are not redistributed through the repo; footage/CLIP_LEDGER.md records them
source/public/footage/*
!source/public/footage/.gitkeep
# Regenerated audio and QA frame dumps
source/public/short/sfx_short.wav
source/public/companion/narration_companion.wav
qa/**/f[0-9]*.png
tools/__pycache__/
# Source recordings downloaded from the draft release (not redistributed through the repo)
footage/release/
source/public/short/narration_short.wav
# Frame scans of Tesla footage and per-slot sheets are regenerated by tools/scan_window.sh and tools/ingest_footage.py;
# compact evidence is kept in qa/evidence/
qa/footage_scan/
qa/footage/
qa/**/*.png
!qa/ingest_test_sheet.png
!qa/short_r2/render_sheet.png
source/public/companion/sfx_companion.wav
# Short v3: regenerated narration/effects WAVs and intermediate edits of the takes
source/public/short3/*.wav
audio/short_v3/tight/*.wav
audio/short_v3/tight/*.mp3
source/public/short4/*.wav
audio/short_v4/tight/*.wav
audio/short_v4/tight/*.mp3
