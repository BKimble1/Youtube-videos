 "captions": [
  {
   "text": "Doctors grew an EAR",
   "emph": [
    "ear"
   ],
   "start": 0.0,
   "end": 1.266,
   "show": 0.0,
   "hide": 1.236
  },
  {
   "text": "inside this woman\u2019s FOREARM.",
   "emph": [
    "forearm"
   ],
   "start": 1.276,
   "end": 2.956,
   "show": 1.236,
   "hide": 3.196
  },
  {
   "text": "She lost her ear in a crash,",
   "emph": [],
   "start": 3.236,
   "end": 4.716,
   "show": 3.196,
   "hide": 4.681
  },
  {
   "text": "so surgeons carved a replacement",
   "emph": [],
   "start": 4.721,
   "end": 6.406,
   "show": 4.681,
   "hide": 6.401
  },
  {
   "text": "from her own rib cartilage.",
   "emph": [
    "rib",
    "cartilage"
   ],
   "start": 6.441,
   "end": 7.856,
   "show": 6.401,
   "hide": 8.096
  },
  {
   "text": "They tucked it beneath her arm skin,",
   "emph": [],
   "start": 8.136,
   "end": 9.616,
   "show": 8.096,
   "hide": 9.586
  },
  {
   "text": "where new blood vessels formed around it.",
   "emph": [],
   "start": 9.626,
   "end": 11.526,
   "show": 9.586,
   "hide": 11.766
  },
  {
   "text": "Months later,",
   "emph": [],
   "start": 11.806,
   "end": 12.396,
   "show": 11.766,
   "hide": 12.361
  },
  {
   "text": "they moved the living ear to her head,",
   "emph": [],
   "start": 12.401,
   "end": 14.196,
   "show": 12.361,
   "hide": 14.376
  },
  {
   "text": "reconnecting its blood supply and nerves.",
   "emph": [],
   "start": 14.416,
   "end": 16.456,
   "show": 14.376,
   "hide": 16.696
  },
  {
   "text": "And for MONTHS\u2026",
   "emph": [
    "months"
   ],
   "start": 16.736,
   "end": 17.676,
   "show": 16.696,
   "hide": 17.936
  },
  {
   "text": "her new ear was right HERE.",
   "emph": [
    "here"
   ],
   "start": 17.976,
   "end": 19.756,
   "show": 17.936,
   "hide": 20.3
  }
 ],
