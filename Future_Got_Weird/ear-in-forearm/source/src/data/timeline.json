 "captions": [
  {
   "text": "Doctors grew an EAR",
   "emph": [
    "ear"
   ],
   "start": 0.0,
   "end": 1.266,
   "show": 0.0,
   "hide": 1.236
  },
  {
   "text": "inside this woman\u2019s FOREARM.",
   "emph": [
    "forearm"
   ],
   "start": 1.276,
   "end": 2.956,
   "show": 1.236,
   "hide": 3.386
  },
  {
   "text": "She lost her ear in a crash,",
   "emph": [],
   "start": 3.426,
   "end": 4.906,
   "show": 3.386,
   "hide": 4.871
  },
  {
   "text": "so surgeons carved a replacement",
   "emph": [],
   "start": 4.911,
   "end": 6.596,
   "show": 4.871,
   "hide": 6.591
  },
  {
   "text": "from her own rib cartilage.",
   "emph": [
    "rib",
    "cartilage"
   ],
   "start": 6.631,
   "end": 8.046,
   "show": 6.591,
   "hide": 8.386
  },
  {
   "text": "They tucked it beneath her arm skin,",
   "emph": [],
   "start": 8.426,
   "end": 9.906,
   "show": 8.386,
   "hide": 9.876
  },
  {
   "text": "where new blood vessels formed around it.",
   "emph": [],
   "start": 9.916,
   "end": 11.816,
   "show": 9.876,
   "hide": 12.266
  },
  {
   "text": "Months later,",
   "emph": [],
   "start": 12.306,
   "end": 12.896,
   "show": 12.266,
   "hide": 12.861
  },
  {
   "text": "they moved the living ear to her head,",
   "emph": [],
   "start": 12.901,
   "end": 14.696,
   "show": 12.861,
   "hide": 14.876
  },
  {
   "text": "reconnecting its blood supply and nerves.",
   "emph": [],
   "start": 14.916,
   "end": 16.956,
   "show": 14.876,
   "hide": 17.626
  },
  {
   "text": "And for MONTHS\u2026",
   "emph": [
    "months"
   ],
   "start": 17.666,
   "end": 18.606,
   "show": 17.626,
   "hide": 18.886
  },
  {
   "text": "her new ear was right HERE.",
   "emph": [
    "here"
   ],
   "start": 18.926,
   "end": 20.706,
   "show": 18.886,
   "hide": 21.5
  }
 ],
