 "captions": [
  {
   "text": "Doctors grew an EAR",
   "emph": [
    "ear"
   ],
   "start": 0.0,
   "end": 1.266,
   "show": 0.0,
   "hide": 1.236
  },
  {
   "text": "inside this woman\u2019s FOREARM.",
   "emph": [
    "forearm"
   ],
   "start": 1.276,
   "end": 2.956,
   "show": 1.236,
   "hide": 3.116
  },
  {
   "text": "She lost her ear in a crash,",
   "emph": [],
   "start": 3.156,
   "end": 4.636,
   "show": 3.116,
   "hide": 4.601
  },
  {
   "text": "so surgeons carved a replacement",
   "emph": [],
   "start": 4.641,
   "end": 6.326,
   "show": 4.601,
   "hide": 6.321
  },
  {
   "text": "from her own rib cartilage.",
   "emph": [
    "rib",
    "cartilage"
   ],
   "start": 6.361,
   "end": 7.776,
   "show": 6.321,
   "hide": 7.936
  },
  {
   "text": "They tucked it beneath her arm skin,",
   "emph": [],
   "start": 7.976,
   "end": 9.456,
   "show": 7.936,
   "hide": 9.426
  },
  {
   "text": "where new blood vessels formed around it.",
   "emph": [],
   "start": 9.466,
   "end": 11.366,
   "show": 9.426,
   "hide": 11.526
  },
  {
   "text": "Months later,",
   "emph": [],
   "start": 11.566,
   "end": 12.156,
   "show": 11.526,
   "hide": 12.121
  },
  {
   "text": "they moved the living ear to her head,",
   "emph": [],
   "start": 12.161,
   "end": 13.956,
   "show": 12.121,
   "hide": 14.136
  },
  {
   "text": "reconnecting its blood supply and nerves.",
   "emph": [],
   "start": 14.176,
   "end": 16.216,
   "show": 14.136,
   "hide": 16.376
  },
  {
   "text": "And for MONTHS\u2026",
   "emph": [
    "months"
   ],
   "start": 16.416,
   "end": 17.356,
   "show": 16.376,
   "hide": 17.536
  },
  {
   "text": "her new ear was right HERE.",
   "emph": [
    "here"
   ],
   "start": 17.576,
   "end": 19.356,
   "show": 17.536,
   "hide": 19.8
  }
