 "captions": [
  {
   "text": "This skateboard",
   "emph": [],
   "start": 0.13,
   "end": 0.96,
   "show": 0.09,
   "hide": 0.98
  },
  {
   "text": "could make you FLY",
   "emph": [
    "fly"
   ],
   "start": 1.02,
   "end": 1.96,
   "show": 0.98,
   "hide": 1.98
  },
  {
   "text": "across a RIVER.",
   "emph": [
    "river"
   ],
   "start": 2.02,
   "end": 2.9,
   "show": 1.98,
   "hide": 3.37
  },
  {
   "text": "You see, ten powerful",
   "emph": [],
   "start": 3.41,
   "end": 4.84,
   "show": 3.37,
   "hide": 4.84
  },
  {
   "text": "electric propellers",
   "emph": [],
   "start": 4.88,
   "end": 5.7,
   "show": 4.84,
   "hide": 5.82
  },
  {
   "text": "blast air downward,",
   "emph": [],
   "start": 5.86,
   "end": 6.96,
   "show": 5.82,
   "hide": 7.12
  },
  {
   "text": "lifting you completely",
   "emph": [],
   "start": 7.16,
   "end": 8.2,
   "show": 7.12,
   "hide": 8.22
  },
  {
   "text": "off the ground.",
   "emph": [],
   "start": 8.26,
   "end": 8.86,
   "show": 8.22,
   "hide": 9.27
  },
  {
   "text": "But his first version",
   "emph": [],
   "start": 9.31,
   "end": 10.32,
   "show": 9.27,
   "hide": 10.36
  },
  {
   "text": "used JET ENGINES\u2026",
   "emph": [
    "jet",
    "engines"
   ],
   "start": 10.4,
   "end": 11.46,
   "show": 10.36,
   "hide": 11.86
  },
  {
   "text": "and caught FIRE.",
   "emph": [
    "fire"
   ],
   "start": 11.9,
   "end": 12.92,
   "show": 11.86,
   "hide": 13.27
  },
  {
   "text": "So he switched to electric.",
   "emph": [],
   "start": 13.64,
   "end": 14.98,
   "show": 13.6,
   "hide": 15.44
  },
  {
   "text": "Except there\u2019s",
   "emph": [],
   "start": 15.48,
   "end": 16.14,
   "show": 15.44,
   "hide": 16.16
  },
  {
   "text": "one HUGE problem.",
   "emph": [
    "huge"
   ],
   "start": 16.2,
   "end": 17.62,
   "show": 16.16,
   "hide": 18.04
  },
  {
   "text": "The board can\u2019t",
   "emph": [],
   "start": 18.08,
   "end": 18.86,
   "show": 18.04,
   "hide": 18.86
  },
  {
   "text": "balance itself.",
   "emph": [],
   "start": 18.9,
   "end": 19.74,
   "show": 18.86,
   "hide": 20.17
  },
  {
   "text": "He has to control it",
   "emph": [],
   "start": 20.21,
   "end": 21.08,
   "show": 20.17,
   "hide": 21.08
  },
  {
   "text": "with his entire BODY,",
   "emph": [
    "body"
   ],
   "start": 21.12,
   "end": 22.26,
   "show": 21.08,
   "hide": 22.44
  },
  {
   "text": "while an AI voice coach",
   "emph": [],
   "start": 22.48,
   "end": 23.66,
   "show": 22.44,
   "hide": 23.66
  },
  {
   "text": "helps him learn",
   "emph": [],
   "start": 23.7,
   "end": 24.22,
   "show": 23.66,
   "hide": 24.22
  },
  {
   "text": "how to balance.",
   "emph": [],
   "start": 24.26,
   "end": 24.88,
   "show": 24.22,
   "hide": 25.32
  },
  {
   "text": "And after just over",
   "emph": [],
   "start": 25.36,
   "end": 26.3,
   "show": 25.32,
   "hide": 26.3
  },
  {
   "text": "ten days of practice,",
   "emph": [],
   "start": 26.34,
   "end": 27.44,
   "show": 26.3,
   "hide": 27.63
  },
  {
   "text": "he actually flew",
   "emph": [],
   "start": 27.67,
   "end": 28.56,
   "show": 27.63,
   "hide": 28.56
  },
  {
   "text": "across a RIVER\u2026",
   "emph": [
    "river"
   ],
   "start": 28.6,
   "end": 29.46,
   "show": 28.56,
   "hide": 29.72
  },
  {
   "text": "and THROUGH a CANYON.",
   "emph": [
    "through",
    "canyon"
   ],
   "start": 29.76,
   "end": 30.96,
   "show": 29.72,
   "hide": 31.31
  },
  {
   "text": "How much would someone",
   "emph": [],
   "start": 31.79,
   "end": 32.48,
   "show": 31.75,
   "hide": 32.5
  },
  {
   "text": "have to PAY YOU",
   "emph": [
    "pay",
    "you"
   ],
   "start": 32.54,
   "end": 33.34,
   "show": 32.5,
   "hide": 33.34
  },
  {
   "text": "to ride this thing?",
   "emph": [],
   "start": 33.38,
   "end": 34.16,
   "show": 33.34,
   "hide": 34.51
  }
 ],
