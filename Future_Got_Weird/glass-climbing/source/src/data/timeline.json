 "duration": 39.03333333333333,
 "captions": [
  {
   "text": "If you pressed these pads",
   "emph": [
    "pads"
   ],
   "start": 0.0,
   "end": 1.16,
   "show": 0,
   "hide": 1.13
  },
  {
   "text": "against a glass wall,",
   "emph": [
    "glass"
   ],
   "start": 1.17,
   "end": 2.38,
   "show": 1.13,
   "hide": 2.39
  },
  {
   "text": "you could lift your feet",
   "emph": [
    "lift",
    "feet"
   ],
   "start": 2.43,
   "end": 3.41,
   "show": 2.39,
   "hide": 3.37
  },
  {
   "text": "off the ground\u2014",
   "emph": [],
   "start": 3.41,
   "end": 4.07,
   "show": 3.37,
   "hide": 4.06
  },
  {
   "text": "and climb it like Spider-Man.",
   "emph": [
    "spiderman"
   ],
   "start": 4.1,
   "end": 5.67,
   "show": 4.06,
   "hide": 5.98
  },
  {
   "text": "Their surfaces are covered",
   "emph": [],
   "start": 6.02,
   "end": 7.23,
   "show": 5.98,
   "hide": 7.19
  },
  {
   "text": "in microscopic wedges.",
   "emph": [
    "microscopic",
    "wedges"
   ],
   "start": 7.23,
   "end": 8.7,
   "show": 7.19,
   "hide": 8.99
  },
  {
   "text": "As you pull downward,",
   "emph": [
    "downward"
   ],
   "start": 9.03,
   "end": 10.11,
   "show": 8.99,
   "hide": 10.23
  },
  {
   "text": "the wedges bend flat",
   "emph": [
    "flat"
   ],
   "start": 10.27,
   "end": 11.42,
   "show": 10.23,
   "hide": 11.42
  },
  {
   "text": "against the glass.",
   "emph": [],
   "start": 11.46,
   "end": 12.38,
   "show": 11.42,
   "hide": 12.73
  },
  {
   "text": "This brings them so close",
   "emph": [
    "close"
   ],
   "start": 12.77,
   "end": 14.13,
   "show": 12.73,
   "hide": 14.09
  },
  {
   "text": "that tiny molecular attractions",
   "emph": [
    "molecular"
   ],
   "start": 14.13,
   "end": 15.89,
   "show": 14.09,
   "hide": 15.85
  },
  {
   "text": "can hold your entire weight.",
   "emph": [
    "entire",
    "weight"
   ],
   "start": 15.89,
   "end": 17.43,
   "show": 15.85,
   "hide": 17.78
  },
  {
   "text": "Special springs spread the load,",
   "emph": [
    "springs"
   ],
   "start": 17.82,
   "end": 19.67,
   "show": 17.78,
   "hide": 19.76
  },
  {
   "text": "so one little patch",
   "emph": [
    "patch"
   ],
   "start": 19.8,
   "end": 20.87,
   "show": 19.76,
   "hide": 20.83
  },
  {
   "text": "doesn\u2019t have to hold you up alone.",
   "emph": [
    "alone"
   ],
   "start": 20.87,
   "end": 22.27,
   "show": 20.83,
   "hide": 22.65
  },
  {
   "text": "Then, you shift your weight",
   "emph": [
    "shift"
   ],
   "start": 22.69,
   "end": 24.17,
   "show": 22.65,
   "hide": 24.14
  },
  {
   "text": "onto the other pad.",
   "emph": [],
   "start": 24.18,
   "end": 25.22,
   "show": 24.14,
   "hide": 25.59
  },
  {
   "text": "The first releases,",
   "emph": [
    "releases"
   ],
   "start": 25.63,
   "end": 26.64,
   "show": 25.59,
   "hide": 26.71
  },
  {
   "text": "letting you reach",
   "emph": [],
   "start": 26.75,
   "end": 27.38,
   "show": 26.71,
   "hide": 27.34
  },
  {
   "text": "higher and repeat.",
   "emph": [
    "higher"
   ],
   "start": 27.38,
   "end": 28.61,
   "show": 27.34,
   "hide": 28.92
  },
  {
   "text": "But there\u2019s a catch.",
   "emph": [
    "catch"
   ],
   "start": 28.96,
   "end": 29.82,
   "show": 28.92,
   "hide": 30.13
  },
  {
   "text": "They need a smooth surface",
   "emph": [
    "smooth"
   ],
   "start": 30.17,
   "end": 31.54,
   "show": 30.13,
   "hide": 31.5
  },
  {
   "text": "to grip.",
   "emph": [],
   "start": 31.54,
   "end": 32.02,
   "show": 31.5,
   "hide": 32.34
  },
  {
   "text": "So you can climb glass\u2014",
   "emph": [
    "glass"
   ],
   "start": 32.38,
   "end": 33.79,
   "show": 32.34,
   "hide": 33.91
  },
  {
   "text": "but switch to rough brick,",
   "emph": [
    "rough",
    "brick"
   ],
   "start": 33.95,
   "end": 35.28,
   "show": 33.91,
   "hide": 35.44
  },
  {
   "text": "and those microscopic wedges",
   "emph": [],
   "start": 35.48,
   "end": 36.9,
   "show": 35.44,
   "hide": 36.87
  },
  {
   "text": "can\u2019t make the same contact.",
   "emph": [
    "contact"
   ],
   "start": 36.91,
   "end": 38.32,
   "show": 36.87,
   "hide": 38.67
  }
 ],
