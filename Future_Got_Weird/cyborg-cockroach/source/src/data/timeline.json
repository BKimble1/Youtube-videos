 "speech_end": 30.59,
 "captions": [
  {
   "text": "This cockroach can fire a needle.",
   "emph": [
    "needle"
   ],
   "start": 0.0,
   "end": 1.82,
   "show": 0.0,
   "hide": 2.165
  },
  {
   "text": "And a person holding a remote",
   "emph": [
    "remote"
   ],
   "start": 2.205,
   "end": 3.44,
   "show": 2.165,
   "hide": 3.4
  },
  {
   "text": "decides when it shoots.",
   "emph": [],
   "start": 3.44,
   "end": 4.535,
   "show": 3.4,
   "hide": 4.945
  },
  {
   "text": "Scientists strapped a tiny launcher",
   "emph": [],
   "start": 4.985,
   "end": 6.66,
   "show": 4.945,
   "hide": 6.62
  },
  {
   "text": "onto a living cockroach,",
   "emph": [
    "living"
   ],
   "start": 6.66,
   "end": 7.93,
   "show": 6.62,
   "hide": 8.05
  },
  {
   "text": "then used electrical pulses",
   "emph": [],
   "start": 8.09,
   "end": 9.42,
   "show": 8.05,
   "hide": 9.38
  },
  {
   "text": "to steer it.",
   "emph": [
    "steer"
   ],
   "start": 9.42,
   "end": 9.96,
   "show": 9.38,
   "hide": 10.45
  },
  {
   "text": "A second cockroach",
   "emph": [
    "second"
   ],
   "start": 10.49,
   "end": 11.37,
   "show": 10.45,
   "hide": 11.33
  },
  {
   "text": "carries a camera,",
   "emph": [],
   "start": 11.37,
   "end": 12.195,
   "show": 11.33,
   "hide": 12.385
  },
  {
   "text": "letting the operator watch",
   "emph": [],
   "start": 12.425,
   "end": 13.56,
   "show": 12.385,
   "hide": 13.52
  },
  {
   "text": "as the first moves into position.",
   "emph": [],
   "start": 13.56,
   "end": 15.07,
   "show": 13.52,
   "hide": 15.495
  },
  {
   "text": "Once it lines up,",
   "emph": [],
   "start": 15.535,
   "end": 16.25,
   "show": 15.495,
   "hide": 16.475
  },
  {
   "text": "they fire the injector.",
   "emph": [],
   "start": 16.515,
   "end": 17.68,
   "show": 16.475,
   "hide": 18.1
  },
  {
   "text": "They’ve demonstrated this",
   "emph": [],
   "start": 18.14,
   "end": 19.04,
   "show": 18.1,
   "hide": 19.0
  },
  {
   "text": "on laboratory targets.",
   "emph": [
    "laboratory"
   ],
   "start": 19.04,
   "end": 20.195,
   "show": 19.0,
   "hide": 20.6
  },
  {
   "text": "But the plan is to send them",
   "emph": [],
   "start": 20.64,
   "end": 21.84,
   "show": 20.6,
   "hide": 21.8
  },
  {
   "text": "beneath collapsed buildings,",
   "emph": [
    "collapsed"
   ],
   "start": 21.84,
   "end": 23.23,
   "show": 21.8,
   "hide": 23.335
  },
  {
   "text": "carrying emergency medicine.",
   "emph": [
    "medicine"
   ],
   "start": 23.375,
   "end": 24.835,
   "show": 23.335,
   "hide": 25.23
  },
  {
   "text": "So if you’re trapped",
   "emph": [],
   "start": 25.27,
   "end": 26.43,
   "show": 25.23,
   "hide": 26.39
  },
  {
   "text": "and something starts",
   "emph": [],
   "start": 26.43,
   "end": 27.26,
   "show": 26.39,
   "hide": 27.22
  },
  {
   "text": "crawling toward you…",
   "emph": [],
   "start": 27.26,
   "end": 28.275,
   "show": 27.22,
   "hide": 28.635
  },
  {
   "text": "you might actually want it",
   "emph": [],
   "start": 28.675,
   "end": 29.79,
   "show": 28.635,
   "hide": 29.75
  },
  {
   "text": "to get closer.",
   "emph": [
    "closer"
   ],
   "start": 29.79,
   "end": 30.59,
   "show": 29.75,
   "hide": 30.94
  }
 ],
