# Dependencies and Remotion caches are rebuilt from package-lock.json
source/node_modules/
source/.remotion/
source/out/
source/.cue_bundle.mjs
# Renders are too large for plain Git blobs (Git LFS uploads are unavailable here); the masters are kept as
# checksummed split parts under backup/ instead
exports/*.mp4
exports/_v3_4k/
# Regenerated deterministically by tools/stitch_narration.py and tools/make_audio.py
audio/narration/narration.wav
audio/mix/*.wav
audio/mix/stems/
source/public/audio/mix.wav
# QA frame dumps (keep sheets and results)
qa/**/f[0-9]*.png
qa/dev/
qa/*.time
# V2: regenerated by tools/v2/stitch_narration_v2.py and tools/v2/make_audio_v2.py; QA frame dumps
v2/audio/narration/narration_v2.wav
v2/audio/mix/*.wav
v2/audio/mix/stems/
source/public/audio/mix_v2.wav
v2/qa/**/f[0-9]*.png
v2/qa/**/*.tsx
v2/qa/render*.log
v2/qa/render*.start
v2/qa/render*.end
# V3: regenerated by tools/v3/make_audio_v3.py; QA frame dumps and render logs
v3/audio/mix/*.wav
v3/audio/mix/stems/
source/public/audio/mix_v3.wav
v3/qa/**/f[0-9]*.png
v3/qa/render*
v3/qa/**/f_*.png
# V4: regenerated by tools/v4/make_audio_v4.py; QA frame dumps and render logs
v4/audio/mix/*.wav
v4/audio/mix/stems/
source/public/audio/mix_v4.wav
v4/qa/**/f[0-9]*.png
v4/qa/**/f_*.png
v4/qa/render*
exports/_v4_4k/
