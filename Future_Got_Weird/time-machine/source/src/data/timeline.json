 "captions": [
  {
   "text": "If you flew close enough to a black hole,",
   "emph": [
    "black",
    "hole"
   ],
   "start": 0.0,
   "end": 2.38,
   "show": 0.0,
   "hide": 2.72
  },
  {
   "text": "you could travel into the future.",
   "emph": [
    "future"
   ],
   "start": 2.76,
   "end": 4.26,
   "show": 2.72,
   "hide": 4.93
  },
  {
   "text": "You'd watch your clock tick for just one hour.",
   "emph": [
    "one",
    "hour"
   ],
   "start": 4.97,
   "end": 7.45,
   "show": 4.93,
   "hide": 8.19
  },
  {
   "text": "But back on Earth,",
   "emph": [
    "earth"
   ],
   "start": 8.23,
   "end": 9.17,
   "show": 8.19,
   "hide": 9.43
  },
  {
   "text": "years could be passing.",
   "emph": [
    "years"
   ],
   "start": 9.47,
   "end": 10.67,
   "show": 9.43,
   "hide": 11.48
  },
  {
   "text": "And when you finally returned,",
   "emph": [
    "returned"
   ],
   "start": 11.52,
   "end": 12.79,
   "show": 11.48,
   "hide": 13.18
  },
  {
   "text": "your friends would be old.",
   "emph": [
    "old"
   ],
   "start": 13.22,
   "end": 14.34,
   "show": 13.18,
   "hide": 14.94
  },
  {
   "text": "Your family might already be gone.",
   "emph": [
    "gone"
   ],
   "start": 15.29,
   "end": 16.83,
   "show": 15.25,
   "hide": 17.43
  },
  {
   "text": "Because you didn't just travel through space.",
   "emph": [
    "space"
   ],
   "start": 17.95,
   "end": 19.95,
   "show": 17.91,
   "hide": 20.75
  },
  {
   "text": "You traveled through time.",
   "emph": [
    "time"
   ],
   "start": 20.79,
   "end": 22.01,
   "show": 20.75,
   "hide": 22.61
  }
 ],
