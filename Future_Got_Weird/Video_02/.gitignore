node_modules/
**/node_modules/
.cache/
__pycache__/
*.pyc
.env
*.key
# Media types are Git LFS types in this repo (.gitattributes); the LFS host is not reachable from the
# production session, so media stays local and is backed up as committed split parts under backup/.
*.wav
*.mp4
*.mp3
*.m4a
*.flac
*.mov
*.webm
!backup/**/*.part*
backup/_stage/
backup/**/*.tar
backup/**/*.tar.tmp
exports/*.zip
# regenerated QA material (dense frames, clips); summaries and contact sheets are kept
qa/frames/
qa/clips/
qa/render/
qa/dense/
work/
source/public/audio/
# research: regenerable run states and the working copy of the authors' repo (re-clone at the pinned commit)
research/code_reproduction/work/
research/code_reproduction/out/**/*.npz
# third-party figures/frames kept only for verification (rights unclear; provenance + hashes are committed)
research/*/evidence/*.jpg
research/*/evidence/*.png
research/*/evidence/*.html
# scene builders' working QA (stills, clips, sheets) changes continuously while scenes are built; the final review
# sheets are added explicitly (git add -f) when the scene is merged
qa/scenes/
qa/cuts/*/
qa/pathfix_*/
# fix-round working renders (stills, clips); the contact sheets are kept
qa/fix1/**/*.png
qa/fix1/**/*.mp4
qa/fix2/**/*.png
qa/fix2/**/*.mp4
