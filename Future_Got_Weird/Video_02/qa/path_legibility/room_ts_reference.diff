+      } else start = ue;
+    }
+    prev = cur;
+    if (!cur) {
+      const p = at(u);
+      const q = onPartitionPlane(p, s, L);
+      const inStrip = q.z >= o.z0 && q.z <= o.z1;
+      const above = q.h - partitionTopH(q.z, L);
