+        const d = Math.hypot(dzOut, dhOut);
+        frontClearPx = Math.min(frontClearPx, d > 0 ? d : -1);
+      }
+    }
+  }
+  if (start !== null && start < 1) spans.push([start, 1]);
+  return {spans, crossings, overPx, frontClearPx};
+};
