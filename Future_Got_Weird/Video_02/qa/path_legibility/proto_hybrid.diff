+/**
+ * How clearly the straight segment a -> b (e.g. a W -> H leg at the sensor height) is seen passing BEHIND the
+ * partition's far end at this tilt: where the projected segment crosses the screen x of the far end's vertical edge
+ * (the camera-facing face at z0), its distance in world px BELOW that edge's top corner (at `cornerH`, default the
+ * layout height; pass the drawn corner height when the top is arched). Positive: the light visibly tucks behind the far
+ * end, i.e. it goes round the end through the gap by the wall (paint it so the partition covers it, or split it with
+ * visibleRuns). Negative: it passes above the corner on screen and reads as "over the top". null: the segment does not
+ * reach that screen x.
+ */
+export const farEndMargin = (a: PlanPt, b: PlanPt, tilt: number, opts: {view?: ViewConfig; layout?: Layout; cornerH?: number} = {}): number | null => {
+  const s = viewAt(tilt, opts.view ?? DEFAULT_VIEW);
+  const o = (opts.layout ?? LAYOUT).occluder;
+  const c = projectWith(s, {x: o.x - o.thickness / 2, z: o.z0, h: opts.cornerH ?? o.height});
+  const pa = projectWith(s, a);
+  const pb = projectWith(s, b);
+  if (Math.abs(pb.x - pa.x) < 1e-9 || (pa.x - c.x) * (pb.x - c.x) > 0) return null;
+  return pa.y + ((pb.y - pa.y) * (c.x - pa.x)) / (pb.x - pa.x) - c.y;
+};
