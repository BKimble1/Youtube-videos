+/**
+ * The gap between the partition's far end and the relay wall, marked ON THE FLOOR: a double-headed dimension arrow
+ * along the partition's own line (x = occluder.x) from the skirting board to the far foot. From
+ * the room cameras the opening itself is seen almost edge-on (a ~50 px slot), but its floor is a long strip running
+ * from the far foot to the wall, right under the spot where the light paths tuck behind the far end: that is where
+ * "the gap" reads. World px; draw it in RoomSet's `backdrop`, so the partition and anyone standing in front cover it.
+ * `t` draws it on from the wall (0..1). While the partition is pushed back, pass the moved layout: the marker shrinks
+ * with the gap and is gone once the far end meets the wall.
+ */
+export const GapMarker: React.FC<{tilt: number; t?: number; opacity?: number; layout?: Layout; view?: ViewConfig; color?: string}> = ({
+  tilt,
+  t = 1,
+  opacity = 1,
+  layout = LAYOUT,
+  view = DEFAULT_VIEW,
+  color = C.inkSoft,
+}) => {
+  const o = layout.occluder;
+  const za = 0.05; // just off the skirting board
+  const zb = o.z0 - 0.06; // just short of the far foot
+  if (t <= 0 || opacity <= 0.001 || zb - za < 0.05) return null;
+  const s = viewAt(tilt, view);
+  const P = (x: number, z: number) => projectWith(s, {x, z, h: 0});
+  const ze = za + (zb - za) * Math.min(1, t);
+  const pt = (p: {x: number; y: number}) => `${p.x.toFixed(2)} ${p.y.toFixed(2)}`;
+  // arrowheads on the floor, pointing at the wall (z = za) and at the far foot (z = zb)
+  const head = (z: number, dir: 1 | -1) => `M ${pt(P(o.x - 0.075, z + dir * 0.085))} L ${pt(P(o.x, z))} L ${pt(P(o.x + 0.075, z + dir * 0.085))}`;
+  const d = [`M ${pt(P(o.x, za))} L ${pt(P(o.x, ze))}`, head(za, 1), ...(t >= 1 ? [head(zb, -1)] : [])].join(' ');
+  return (
+    <svg width={1920} height={1080} style={{position: 'absolute', left: 0, top: 0, overflow: 'visible'}}>
+      <g opacity={opacity} fill="none" strokeLinecap="round">
+        <path d={d} stroke={C.cream} strokeWidth={11} strokeLinejoin="round" />
+        <path d={d} stroke={color} strokeWidth={5} strokeLinejoin="round" />
+      </g>
+    </svg>
