  "onset": 1.08,
  "lead_vs_onset_frames": -0.09,
  "lead_vs_wordframe": 1.51,
  "continuous": false,
  "last_word": "him.",
  "speech_off": 2.33,
  "out_minus_speech_off_frames": 6.99
 },
 {
  "n": 2,
  "text": "It's pointed at a plain, blank wall.",
  "start": 2.643,
  "end": 4.888,
  "first_word": "It's",
  "word_frame": 81,
  "onset": 2.69,
  "lead_vs_onset_frames": 1.41,
  "lead_vs_wordframe": 1.71,
  "continuous": false,
  "last_word": "wall.",
  "speech_off": 4.67,
  "out_minus_speech_off_frames": 6.54
 },
 {
  "n": 3,
  "text": "Yet researchers have / used light bouncing off",
