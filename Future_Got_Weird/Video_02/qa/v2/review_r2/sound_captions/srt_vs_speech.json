  "end": 7.768,
  "first_word": "Yet",
  "word_frame": 151,
  "onset": 4.95,
  "lead_vs_onset_frames": -0.54,
  "lead_vs_wordframe": 1.96,
  "continuous": false,
  "last_word": "off",
  "speech_off": null,
  "out_minus_speech_off_frames": null
 },
 {
  "n": 4,
  "text": "a wall to track someone / hidden around a corner.",
  "start": 7.848,
  "end": 10.288,
  "first_word": "a",
  "word_frame": 237,
  "onset": null,
  "lead_vs_onset_frames": null,
  "lead_vs_wordframe": 1.56,
  "continuous": true,
  "last_word": "corner.",
  "speech_off": 10.08,
  "out_minus_speech_off_frames": 6.24
 },
 {
  "n": 5,
  "text": "That dot is their position / estimate. Not a photograph.",
  "start": 10.368,
  "end": 14.095,
  "first_word": "That",
  "word_frame": 313,
  "onset": 10.31,
  "lead_vs_onset_frames": -1.74,
