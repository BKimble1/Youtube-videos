  "end": 145.93,
  "first_word": "rebuilt",
  "word_frame": 4297,
  "onset": null,
  "lead_vs_onset_frames": null,
  "lead_vs_wordframe": 2.11,
  "continuous": true,
  "last_word": "U.",
  "speech_off": 145.34,
  "out_minus_speech_off_frames": 17.7
 },
 {
  "n": 49,
  "text": "In 2012, an MIT team rebuilt the rough / 3D shape of a hidden mannequin.",
  "start": 149.253,
  "end": 154.373,
  "first_word": "In",
  "word_frame": 4480,
  "onset": 149.33,
  "lead_vs_onset_frames": 2.31,
  "lead_vs_wordframe": 2.41,
  "continuous": false,
  "last_word": "mannequin.",
  "speech_off": 153.99,
  "out_minus_speech_off_frames": 11.49
 },
 {
  "n": 50,
  "text": "By 2021, others had live / video around corners.",
  "start": 154.453,
  "end": 157.968,
  "first_word": "By",
  "word_frame": 4636,
  "onset": 154.52,
