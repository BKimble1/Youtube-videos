# Dependencies and caches
node_modules/
**/node_modules/
.cache/
__pycache__/
*.pyc

# Regenerable intermediates (rebuild with the commands in README.md)
previews/
audio/music/stems/
audio/music/music_bed.wav
audio/mix/stem_*.wav
audio/sfx/sfx_track.wav
audio/narration/placeholder/
audio/narration/draft_local/draft_full.wav
audio/narration/narration_*.wav
source/public/audio/
source/public/smoke/
assets/downloads/**/*.jpg
assets/downloads/**/*.tif

# Secrets never belong in the project
.env
*.key
audio/mix/final_mix.wav

# Audio/video are Git LFS types in this repo (.gitattributes). The LFS host is blocked from the
# production session, so media files stay local; push them from a machine with LFS access.
*.wav
*.mp4
*.mp3
*.m4a
*.aac
*.flac

# v3 review sheets are committed as JPEG copies
qa/review_v3/*.png
qa/review_v4/*.png
qa/review_v4/frames/
qa/render_chain.status
# The project zip duplicates the repository contents (and is ~100 MB); it stays local
exports/*.zip
